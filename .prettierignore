# Generated code — produced by codegen (lunora) and fumadocs-mdx (.source); never lint/format
**/_generated/
**/.source/

# Public-API snapshots — generated by scripts/api-snapshot.js (pnpm run api:update);
# formatting is owned by the generator, and a Prettier rewrite would break the
# byte-for-byte comparison in `pnpm run api:check`.
api-snapshots/

# Generated route tree (TanStack Router) — rewritten on every build
**/*.gen.ts

# Package docs copied + sanitized from packages/*/docs by copy-package-docs.js
apps/docs/src/content/docs/packages/
# Generated by apps/docs `copy-package-docs.js` (git-ignored, but prettier does not
# read .gitignore) — a local docs build otherwise fails the repo prettier gate.
apps/docs/src/content/changelogs/

# Build artifacts (Remotion video bundles) — not source
marketing/videos/build/

# deepsec security tool working directory — vendored, scanned, not ours to format
.deepsec/

# Non-JS SDK build output. Git ignores these, but Prettier does not read
# .gitignore, so a local `lint:prettier` otherwise reports dozens of warnings for
# swiftpm and cargo intermediates that no CI checkout even contains.
sdks/*/.build/
sdks/**/target/
sdks/**/.dart_tool/

# Schema baselines — written by `serializeSchemaSnapshot`, whose exact output is
# the canonical form. Prettier reformats them to 4-space, so every
# `lunora prepare --update-schema-baseline` produced a file that then failed
# `lint:prettier` until someone re-ran `--write`. The serializer owns this
# format, not Prettier. (Safe: the ledger hash is taken from the re-serialized
# object, never from the file's bytes, so on-disk spacing cannot shift a
# schema version's identity.)
**/.lunora-schema.json

# Netlify's build output for the docs site. Gitignored, so it only exists in a
# checkout where `apps/docs` has been built — and then `lint:prettier` fails on
# a bundle no one wrote and no one can usefully format.
**/.netlify
