# Public-API snapshots — generated by scripts/api-snapshot.js (pnpm run api:update);
# formatting is owned by the generator, and a Prettier rewrite would break the
# byte-for-byte comparison in `pnpm run api:check`.
api-snapshots/

# Generated route tree (TanStack Router) — rewritten on every build
**/*.gen.ts

# Package docs copied + sanitized from packages/*/docs by copy-package-docs.js
apps/docs/src/content/docs/packages/
# Generated by apps/docs `copy-package-docs.js` (git-ignored, but prettier does not
# read .gitignore) — a local docs build otherwise fails the repo prettier gate.
apps/docs/src/content/changelogs/

# Build artifacts (Remotion video bundles) — not source
marketing/videos/build/

