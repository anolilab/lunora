{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "lunora-example-blog",
    "main": "src/server/index.ts",
    "compatibility_date": "2026-04-07",
    "compatibility_flags": ["nodejs_compat"],
    "durable_objects": {
        "bindings": [
            { "name": "SHARD", "class_name": "ShardDO" },
            { "name": "SCHEDULER", "class_name": "SchedulerDO" },
        ],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShardDO", "SchedulerDO"] }],
    "observability": { "enabled": true, "head_sampling_rate": 1 },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "lunora-example-blog",
            "database_id": "<replace-with-d1-create-id>",
        },
    ],
    "r2_buckets": [
        {
            "binding": "FILES",
            "bucket_name": "lunora-example-blog-files",
        },
    ],
    // `index_name` must match the schema's logical index name (`.vectorize("body",
    // { index: "posts_search" })`); `binding` is the env var the worker reads.
    // Create the index first: wrangler vectorize create posts_search --dimensions=256 --metric=cosine
    "vectorize": [
        {
            "binding": "POSTS_SEARCH",
            "index_name": "posts_search",
        },
    ],
    // Kept in sync with `LUNORA_CRON_TRIGGERS` in `lunora/_generated/crons.ts`,
    // which codegen derives from `lunora/crons.ts`. Declare schedules there, not
    // here — the dev server's vite plugin reconciles this list on every schema
    // save, and `lunora deploy` / `lunora prepare` reconcile it before shipping.
    // The bare `lunora codegen` command does NOT: it writes `_generated/` and
    // leaves this file alone, so a schedule added while the dev server is down
    // reaches wrangler only on the next deploy.
    "triggers": {
        "crons": ["0 3 * * *"],
    },
    "vars": {
        "PUBLIC_STORAGE_BASE_URL": "https://files.example.com",
        // REPLACE before deploying to production — this is the origin the Worker
        // is called back on, and pointing it at localhost in production silently
        // breaks scheduled jobs.
        //
        // The SchedulerDO takes its dispatch target from its OWN env and from
        // nowhere else — a caller-supplied one would be an SSRF vector — so
        // without this every `ctx.scheduler.runAfter` is refused with
        // `ORIGIN_NOT_CONFIGURED`.
        "LUNORA_ORIGIN_URL": "http://localhost:8787",
    },
}
