{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "lunora-example-blog",
    "main": "src/server/index.ts",
    "compatibility_date": "2026-04-07",
    "compatibility_flags": ["nodejs_compat"],
    "durable_objects": {
        "bindings": [
            { "name": "SHARD", "class_name": "ShardDO" },
            { "name": "SCHEDULER", "class_name": "SchedulerDO" },
        ],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShardDO", "SchedulerDO"] }],
    "observability": { "enabled": true, "head_sampling_rate": 1 },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "lunora-example-blog",
            "database_id": "<replace-with-d1-create-id>",
        },
    ],
    "r2_buckets": [
        {
            "binding": "FILES",
            "bucket_name": "lunora-example-blog-files",
        },
    ],
    // `index_name` must match the schema's logical index name (`.vectorize("body",
    // { index: "posts_search" })`); `binding` is the env var the worker reads.
    // Create the index first: wrangler vectorize create posts_search --dimensions=256 --metric=cosine
    "vectorize": [
        {
            "binding": "POSTS_SEARCH",
            "index_name": "posts_search",
        },
    ],
    // Kept in sync with `LUNORA_CRON_TRIGGERS` in `lunora/_generated/crons.ts`,
    // which codegen derives from `lunora/crons.ts`. Declare schedules there, not
    // here — the vite plugin reconciles this list on the next `lunora codegen`.
    "triggers": {
        "crons": ["0 3 * * *"],
    },
    "vars": {
        "PUBLIC_STORAGE_BASE_URL": "https://files.example.com",
        // REPLACE both before deploying to production — they are the origin the
        // Worker is called back on. Pointing at localhost in production silently
        // breaks scheduled jobs.
        //
        // `LUNORA_ORIGIN_URL` is the one the SchedulerDO reads: it takes the
        // dispatch target from its OWN env and ignores the `originUrl` passed to
        // `createScheduler` (a caller-supplied target would be an SSRF vector).
        // Without it every `ctx.scheduler.runAfter` is refused with
        // `ORIGIN_NOT_CONFIGURED`. `LUNORA_WORKER_ORIGIN` is the cross-shard
        // relation resolver's.
        "LUNORA_ORIGIN_URL": "http://localhost:8787",
        "LUNORA_WORKER_ORIGIN": "http://localhost:8787",
    },
}
