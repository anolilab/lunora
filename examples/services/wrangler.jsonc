{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "lunora-example-services",
    "main": "src/server/index.ts",
    "compatibility_date": "2026-10-01",
    "compatibility_flags": ["nodejs_compat"],
    "durable_objects": {
        "bindings": [
            { "name": "SHARD", "class_name": "ShardDO" },
            { "name": "ADMIN_REVOCATIONS", "class_name": "AdminRevocationDO" },
        ],
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ShardDO"] },
        { "tag": "v2", "new_sqlite_classes": ["AdminRevocationDO"] },
    ],
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "redact_query_string": true,
    },
    "services": [
        {
            "binding": "SERVICE_GATEWAY",
            "entrypoint": "Gateway",
            "service": "lunora-example-services-gateway",
        },
        {
            "binding": "SERVICE_PARSER",
            "service": "lunora-example-services-parser",
        },
    ],
}
