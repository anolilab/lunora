{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "lunora-example-privacy",
    "main": "src/server/index.ts",
    "compatibility_date": "2026-10-01",
    "compatibility_flags": ["nodejs_compat"],
    "d1_databases": [
        // The sign-in tables (better-auth's user, session, account) live in D1, outside the shard. Erasure
        // reaches them only from the workflow, through `ctx.env.DB`.
        { "binding": "DB", "database_name": "lunora-example-privacy", "database_id": "<replace-with-d1-create-id>" },
    ],
    "durable_objects": {
        "bindings": [
            { "name": "SHARD", "class_name": "ShardDO" },
            // The erasure tombstones, kept out of the shard so a point-in-time restore of the shard cannot delete them.
            { "name": "PRIVACY_TOMBSTONES", "class_name": "PrivacyTombstonesDO" },
        ],
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ShardDO"] },
        { "tag": "v2", "new_sqlite_classes": ["PrivacyTombstonesDO"] },
    ],
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
    },
    "upload_source_maps": true,
    "exports": {
        "PrivacyErasureWorkflow": {
            "type": "workflow",
            "limits": {
                "steps": 25000,
            },
            "name": "privacy-erasure",
        },
        "PrivacyExportWorkflow": {
            "type": "workflow",
            "limits": {
                "steps": 25000,
            },
            "name": "privacy-export",
        },
        "PrivacyRestoreWorkflow": {
            "type": "workflow",
            "limits": {
                "steps": 25000,
            },
            "name": "privacy-restore",
        },
    },
    "triggers": {
        "crons": ["0 6 * * *"],
    },
}
