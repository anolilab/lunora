{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "lunora-example-chess",
    "main": "src/server/index.ts",
    "compatibility_date": "2026-10-01",
    "compatibility_flags": ["nodejs_compat"],
    "durable_objects": {
        "bindings": [
            { "name": "SHARD", "class_name": "ShardDO" },
            { "name": "ADMIN_REVOCATIONS", "class_name": "AdminRevocationDO" },
        ],
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ShardDO"] },
        { "tag": "v2", "new_sqlite_classes": ["AdminRevocationDO"] },
    ],
    "observability": { "enabled": true, "head_sampling_rate": 1, "redact_query_string": true },
    "d1_databases": [
        // better-auth's identity tables only — the game state itself lives in
        // the ShardDO, not in D1.
        { "binding": "DB", "database_name": "lunora-example-chess", "database_id": "<replace-with-d1-create-id>" },
    ],
}
