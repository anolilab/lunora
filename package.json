{
    "name": "cirrus",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/anolilab/cirrus.git"
    },
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "build": "vis run build",
        "build:affected": "vis affected build --fail-fast",
        "build:packages": "vis run build --query \"tag=type:package\"",
        "clean": "vis run clean && rimraf ./node_modules",
        "commit": "git-cz",
        "e2e": "pnpm --filter @cirrus/e2e e2e",
        "e2e:headed": "pnpm --filter @cirrus/e2e e2e:headed",
        "e2e:ui": "pnpm --filter @cirrus/e2e e2e:ui",
        "lint:affected:eslint": "vis affected lint:eslint --fail-fast",
        "lint:affected:types": "vis affected lint:types --fail-fast",
        "lint:eslint": "vis run lint:eslint",
        "lint:eslint:fix": "vis run lint:eslint:fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "vis run lint:types",
        "multi-semantic-release": "multi-semantic-release",
        "prepare": "husky",
        "test": "vis run test --query \"project!=@cirrus/e2e\"",
        "test:affected": "vis affected test --fail-fast --query \"project!=@cirrus/e2e\"",
        "test:clean-machine": "./scripts/clean-machine-smoke.sh",
        "test:coverage": "vis run test:coverage --query \"project!=@cirrus/e2e\""
    },
    "devDependencies": {
        "@anolilab/commitlint-config": "catalog:prod",
        "@anolilab/eslint-config": "catalog:lint",
        "@anolilab/multi-semantic-release": "catalog:prod",
        "@anolilab/prettier-config": "catalog:lint",
        "@anolilab/semantic-release-preset": "catalog:dev",
        "@babel/core": "catalog:build",
        "@commitlint/cli": "catalog:prod",
        "@commitlint/config-conventional": "catalog:prod",
        "@types/node": "catalog:types",
        "@visulima/tabular": "catalog:prod",
        "@visulima/vis": "catalog:prod",
        "cz-conventional-changelog": "catalog:prod",
        "eslint": "catalog:lint",
        "husky": "catalog:lint",
        "prettier": "catalog:lint",
        "rimraf": "catalog:node",
        "ts-morph": "catalog:tooling",
        "tsx": "catalog:dev",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.14.0 || >=24.10.0",
        "pnpm": ">=10.32.1"
    },
    "packageManager": "pnpm@10.32.1"
}
