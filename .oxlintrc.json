                "react-doctor/no-wide-letter-spacing": "off",
                "react-doctor/only-export-components": "off",
                "react-doctor/preact-no-react-hooks-import": "off",
                "react-doctor/preact-prefer-ondblclick": "off",
                "react-doctor/preact-prefer-oninput": "off",
                "react-doctor/prefer-dvh-over-vh": "off",
                "react-doctor/prefer-html-dialog": "off",
                "react-doctor/prefer-module-scope-pure-function": "off",
