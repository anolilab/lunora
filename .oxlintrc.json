                "unicorn/max-nested-calls": "off",
                "unicorn/prefer-number-coercion": "off",

                // eslint enforces these, but oxlint cannot match it: eslint relaxes them per project or
                // per file, or oxlint's version reports code that eslint accepts. eslint stays the gate.
                // - arrow-body-style: eslint relaxes it in replica; elsewhere it reports code that eslint accepts
                // - import/exports-last: eslint relaxes it in privacy, chess, blog and 15 more
                // - import/no-commonjs: eslint relaxes it in expo
                // - import/no-named-as-default: reports code that eslint accepts
                // - import/no-named-as-default-member: reports code that eslint accepts
                // - import/no-namespace: eslint relaxes it in docs, auth-ui, expo
