                "react-doctor/rn-no-inline-flatlist-renderitem": "off",
                "react-doctor/role-button-requires-complete-keyboard-activation": "off",
                "react-doctor/server-sequential-independent-await": "off",
                "react-doctor/use-lazy-motion": "off",
                "react/react-in-jsx-scope": "off",
                "sonarjs/hooks-before-test-cases": "off",
                "sonarjs/no-floating-point-equality": "off",
                "sonarjs/no-trivial-assertions": "off",
                "sonarjs/parameterized-tests": "off",
                "sonarjs/prefer-specific-assertions": "off",
                "sonarjs/super-linear-regex": "off",
