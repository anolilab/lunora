{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "extends": ["./node_modules/@anolilab/oxlint-config/.oxlintrc.json"],
    // eslint is the lint authority; oxlint is a fast first pass that enforces only what eslint
    // enforces (#1455). A rule that flags code eslint accepts belongs in the second "off" list
    // below, not in a code change. It lints only what eslint lints: each project's own files,
    // minus the files that project's eslint config ignores, and none of registry/, templates/,
    // shared/, scripts/ or the tooling directories.
    "ignorePatterns": [
        "**/_generated/**",
        "**/.source/**",
        "**/*.gen.ts",
        "api-snapshots/**",
        "**/__fixtures__/**",
        "**/__tests__/fixtures/**",
        "**/fixtures/**",
        ".agents/**",
        ".claude/skills/**",
        ".vis/**",
        "/*.{cjs,mjs,js,cts,mts,ts}",
        // apps/bench: what its eslint config ignores. The registry / templates/saas copies are owned
        // upstream, its Node scripts sit outside the app's tsconfig like the root scripts/.
        "apps/bench/scripts/**",
        "apps/bench/lunora/ai/**",
        "apps/bench/lunora/auth/**",
        "apps/bench/lunora/flags.ts",
        "apps/bench/lunora/identity.ts",
        "apps/bench/lunora/mail/**",
        "apps/bench/lunora/payment/**",
        "apps/bench/lunora/presence/**",
        "apps/bench/lunora/ratelimit/**",
        "apps/bench/lunora/saas/**",
        "apps/bench/lunora/seats.ts",
        "apps/bench/lunora/storage/**",
        "apps/bench/lunora/domains/**",
        "apps/bench/.bench/**",
        "apps/docs/*",
        "!apps/docs/src",
        "apps/docs/src/components/ui/**",
        "apps/docs/src/data/packages.ts",
        "apps/docs/src/lib/utils.ts",
        "examples/*.js",
        "marketing/**",
        "packages/codegen/scripts/**",
        "packages/studio/src/components/evilcharts/**",
        "packages/studio/src/components/ui/**",
        "packages/studio/src/hooks/use-mobile.ts",
        "packages/studio/src/lib/utils.ts",
        "plans/**",
        "plugins/**",
        "protocol/**",
        "registry/**",
        "scripts/**",
        "sdks/**",
        "shared/**",
        "templates/**",
        "tests/**",
        "tools/**",
        "**/eslint.config.js",
        "**/packem.config.ts",
        "**/prettier.config.js",
        "**/vite.config.ts",
        "**/vitest.bench.config.ts",
        "**/vitest.config.ts"
    ],
    "options": {
        "typeAware": true
    },
