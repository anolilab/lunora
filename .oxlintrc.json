                "react-doctor/jsx-props-no-spreading": "off",
                "react-doctor/nextjs-no-a-element": "off",
                "react-doctor/nextjs-no-img-element": "off",
                "react-doctor/no-all-caps-body-text": "off",
                "react-doctor/no-arbitrary-px-font-size": "off",
