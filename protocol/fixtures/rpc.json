{
    "$comment": "Golden fixtures for the HTTP RPC envelope (POST /_lunora/rpc). `request` cases assert build_rpc_body(functionPath, args, shardKey) == body (an omitted shardKey is dropped from the body). Typed args are supplied wire-encoded in `argsWire` and decoded to native before building. `responseOk` cases assert encode(parse_response(response)) == response.result (the decoded result re-encodes to the same wire). `responseError` cases assert the raised error carries the given code/message (and encode(error.data) == error.data wire when present). `responseTransportError` cases assert that parse_response(response, status) raises the SDK's own error type with the given code — protocol/README.md §4.2's INTERNAL transport error. They are all non-2xx bodies that carry no usable `error` envelope: the key is absent, or it holds something that is not an OBJECT, which a proxy's `{\"error\":\"bad gateway\"}` page is the everyday shape of. Reading such a slot without a type check raises the LANGUAGE's error rather than the SDK's, escaping every handler the caller wrote — which is what two ports did, while the same response was already classified as transport by the batch replay path beside them.",
    "request": {
        "path": "/_lunora/rpc",
        "method": "POST",
        "cases": [
            {
                "name": "query-no-shard",
                "functionPath": "messages:list",
                "args": { "channel": "general", "limit": 50 },
                "body": { "args": { "channel": "general", "limit": 50 }, "functionPath": "messages:list" }
            },
            {
                "name": "query-with-shard",
                "functionPath": "messages:get",
                "args": { "id": "m1" },
                "shardKey": "room-1",
                "body": { "args": { "id": "m1" }, "functionPath": "messages:get", "shardKey": "room-1" }
            },
            {
                "name": "mutation-typed-bigint",
                "functionPath": "ledger:add",
                "argsWire": { "amount": ["$lunora.wire$", "bigint", "7"] },
                "body": { "args": { "amount": ["$lunora.wire$", "bigint", "7"] }, "functionPath": "ledger:add" }
            },
            {
                "name": "empty-args",
                "functionPath": "system:ping",
                "args": {},
                "body": { "args": {}, "functionPath": "system:ping" }
            }
        ]
    },
    "responseOk": [
        { "name": "plain-object", "response": { "result": { "ok": true, "count": 3 } } },
        { "name": "typed-bigint", "response": { "result": ["$lunora.wire$", "bigint", "42"] } },
        { "name": "null-result", "response": { "result": null } },
        { "name": "with-commit-cursor", "response": { "result": { "id": "m9" }, "commitCursor": 12 } },
        { "name": "with-last-mutation-id", "response": { "result": { "id": "m9" }, "lastMutationId": 4 } }
    ],
    "responseError": [
        { "name": "coded", "response": { "error": { "code": "NOT_FOUND", "message": "no such row" } }, "code": "NOT_FOUND", "message": "no such row" },
        {
            "name": "with-data",
            "response": { "error": { "code": "TOO_MANY_REQUESTS", "message": "slow down", "data": { "retryAfterMs": 3000 } } },
            "code": "TOO_MANY_REQUESTS",
            "message": "slow down",
            "dataWire": { "retryAfterMs": 3000 }
        }
    ],
    "responseTransportError": [
        { "name": "no-error-key", "status": 502, "response": { "message": "bad gateway" }, "code": "INTERNAL" },
        { "name": "error-is-a-string", "status": 502, "response": { "error": "bad gateway" }, "code": "INTERNAL" },
        { "name": "error-is-null", "status": 502, "response": { "error": null }, "code": "INTERNAL" },
        { "name": "error-is-an-array", "status": 502, "response": { "error": ["bad gateway"] }, "code": "INTERNAL" },
        { "name": "error-is-a-number", "status": 500, "response": { "error": 7 }, "code": "INTERNAL" }
    ]
}
