{
    "name": "@cirrus/solid",
    "version": "0.0.0",
    "description": "SolidJS adapter for Cirrus — live queries, optimistic mutations, and reactive loaders",
    "license": "FSL-1.1-Apache-2.0",
    "homepage": "https://cirrus.dev",
    "bugs": {
        "url": "https://github.com/anolilab/cirrus/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/cirrus.git",
        "directory": "packages/solid"
    },
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "keywords": [
        "cirrus",
        "cloudflare",
        "workers",
        "durable-objects",
        "solid",
        "solidjs",
        "signals",
        "realtime"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md",
        "__assets__"
    ],
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@cirrus/client": "workspace:*",
        "@cirrus/query-core": "workspace:*",
        "@cirrus/ssr": "workspace:*"
    },
    "devDependencies": {
        "@babel/core": "catalog:build",
        "@solidjs/testing-library": "catalog:frontend",
        "@testing-library/jest-dom": "catalog:frontend",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "babel-preset-solid": "catalog:build",
        "esbuild": "catalog:build",
        "jsdom": "catalog:frontend",
        "solid-js": "catalog:frontend",
        "typescript": "catalog:tsc",
        "vite-plugin-solid": "catalog:frontend",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "solid-js": "^1.9.0"
    },
    "peerDependenciesMeta": {
        "solid-js": {
            "optional": false
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
