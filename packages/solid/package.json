{
    "name": "@lunora/solid",
    "version": "1.0.0-alpha.87",
    "description": "SolidJS adapter for Lunora — live queries, optimistic mutations, and reactive loaders",
    "keywords": [
        "cloudflare",
        "durable-objects",
        "lunora",
        "realtime",
        "signals",
        "solid",
        "solidjs",
        "workers"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/solid"
    },
    "files": [
        "./dist",
        "README.md",
        "LICENSE.md",
        "__assets__"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.mjs"
        },
        "./upload": {
            "types": "./dist/upload.d.ts",
            "import": "./dist/upload.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint . --max-warnings=0",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@lunora/client": "1.0.0-alpha.83",
        "@lunora/errors": "1.0.0-alpha.34",
        "@lunora/ratelimit": "1.0.0-alpha.42",
        "@visulima/storage-client": "catalog:storage"
    },
    "devDependencies": {
        "@babel/core": "catalog:build",
        "@solidjs/testing-library": "catalog:frontend",
        "@testing-library/jest-dom": "catalog:frontend",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "babel-preset-solid": "catalog:build",
        "esbuild": "catalog:build",
        "fallow": "catalog:lint",
        "jsdom": "catalog:frontend",
        "solid-js": "catalog:frontend",
        "typescript": "catalog:tsc",
        "vite-plugin-solid": "catalog:frontend",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "solid-js": "^1.9.0 || ^2.0.0-rc.0"
    },
    "peerDependenciesMeta": {
        "solid-js": {
            "optional": false
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
