{
    "name": "@cirrus/solid",
    "version": "0.0.0",
    "description": "SolidJS adapter for Cirrus — live queries, optimistic mutations, reactive loaders",
    "license": "FSL-1.1-Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@cirrus/client": "workspace:*",
        "@cirrus/ssr": "workspace:*"
    },
    "devDependencies": {
        "@solidjs/testing-library": "catalog:frontend",
        "@testing-library/jest-dom": "catalog:frontend",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "esbuild": "catalog:build",
        "jsdom": "catalog:frontend",
        "solid-js": "catalog:frontend",
        "typescript": "catalog:tsc",
        "vite-plugin-solid": "catalog:frontend",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "solid-js": "^1.9.0"
    },
    "peerDependenciesMeta": {
        "solid-js": {
            "optional": false
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
