{
    "name": "@lunora/testing",
    "version": "1.0.0-alpha.307",
    "description": "Testing toolkit for Lunora: an in-memory harness for queries, mutations, and actions",
    "keywords": [
        "cloudflare",
        "durable-objects",
        "e2e",
        "lunora",
        "mail",
        "playwright",
        "testing",
        "workers"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/testing"
    },
    "files": [
        "./dist",
        "README.md",
        "LICENSE.md",
        "__assets__"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./playwright": {
            "types": "./dist/playwright.d.ts",
            "import": "./dist/playwright.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint . --max-warnings=0",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@lunora/agent": "1.0.0-alpha.251",
        "@lunora/bindings": "1.0.0-alpha.136",
        "@lunora/errors": ">=1.0.0-alpha.51 <2.0.0-0",
        "@lunora/mail": "1.0.0-alpha.125",
        "@lunora/notify": "1.0.0-alpha.98",
        "@lunora/platform": "1.0.0-alpha.75",
        "@lunora/queue": "1.0.0-alpha.129",
        "@lunora/scheduler": "1.0.0-alpha.152",
        "@lunora/server": "1.0.0-alpha.241",
        "@lunora/wire": "1.0.0-alpha.2",
        "@visulima/notification": "catalog:notify",
        "ai": "catalog:ai"
    },
    "devDependencies": {
        "@lunora/observability": "1.0.0-alpha.174",
        "@lunora/ratelimit": "1.0.0-alpha.172",
        "@lunora/shard-engine": "1.0.0-alpha.162",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "fallow": "catalog:lint",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@playwright/test": "^1.61.1"
    },
    "peerDependenciesMeta": {
        "@playwright/test": {
            "optional": true
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
