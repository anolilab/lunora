{
    "name": "@lunora/hyperdrive",
    "version": "1.0.0-alpha.52",
    "description": "Bring-your-own Postgres/MySQL for Lunora via Cloudflare Hyperdrive: a driver-agnostic, action-only ctx.sql",
    "keywords": [
        "cloudflare",
        "database",
        "hyperdrive",
        "lunora",
        "mysql",
        "postgres",
        "sql",
        "workers"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/hyperdrive"
    },
    "files": [
        "./dist",
        "README.md",
        "LICENSE.md",
        "__assets__"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./global": {
            "types": "./dist/global.d.ts",
            "import": "./dist/global.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint . --max-warnings=0",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@lunora/do": "1.0.0-alpha.55",
        "@lunora/errors": "1.0.0-alpha.9",
        "@lunora/sql-store": "1.0.0-alpha.52",
        "drizzle-orm": "catalog:drizzle"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "catalog:cloudflare",
        "@electric-sql/pglite": "0.5.4",
        "@electric-sql/pglite-socket": "0.2.7",
        "@types/node": "catalog:types",
        "@types/pg": "^8.20.0",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "fallow": "catalog:lint",
        "mysql-memory-server": "1.14.1",
        "mysql2": "^3.23.1",
        "pg": "^8.22.0",
        "postgres": "^3.4.9",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "mysql2": "*",
        "pg": "*",
        "postgres": "*"
    },
    "peerDependenciesMeta": {
        "mysql2": {
            "optional": true
        },
        "pg": {
            "optional": true
        },
        "postgres": {
            "optional": true
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
