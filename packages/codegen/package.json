{
    "name": "@cirrus/codegen",
    "version": "0.0.0",
    "license": "FSL-1.1-Apache-2.0",
    "description": "Code generator for Cirrus: emits _generated/{api,server,dataModel}.ts from your schema",
    "homepage": "https://cirrus.dev",
    "bugs": {
        "url": "https://github.com/anolilab/cirrus/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/cirrus.git",
        "directory": "packages/codegen"
    },
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "keywords": [
        "cirrus",
        "cloudflare",
        "workers",
        "durable-objects",
        "codegen",
        "schema",
        "type-safe",
        "ts-morph"
    ],
    "files": [
        "dist",
        "__assets__",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "bench": "vitest bench --run"
    },
    "dependencies": {
        "@cirrus/advisor": "workspace:*",
        "@cirrus/container": "workspace:*",
        "@cirrus/scheduler": "workspace:*",
        "@cirrus/values": "workspace:*",
        "ts-morph": "catalog:tooling"
    },
    "devDependencies": {
        "@cirrus/do": "workspace:*",
        "@cirrus/server": "workspace:*",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "drizzle-orm": "catalog:drizzle",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
