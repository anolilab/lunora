{
    "name": "@lunora/codegen",
    "version": "1.0.0-alpha.2",
    "description": "Code generator for Lunora: emits _generated/{api,server,dataModel}.ts from your schema",
    "keywords": [
        "cloudflare",
        "codegen",
        "durable-objects",
        "lunora",
        "schema",
        "ts-morph",
        "type-safe",
        "workers"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/codegen"
    },
    "files": [
        "dist",
        "__assets__",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:bench": "vitest bench --run --config vitest.bench.config.ts"
    },
    "dependencies": {
        "@lunora/advisor": "1.0.0-alpha.1",
        "@lunora/container": "1.0.0-alpha.1",
        "@lunora/scheduler": "1.0.0-alpha.1",
        "@lunora/values": "1.0.0-alpha.1",
        "@lunora/workflow": "1.0.0-alpha.1",
        "ts-morph": "catalog:tooling"
    },
    "devDependencies": {
        "@codspeed/vitest-plugin": "catalog:test",
        "@lunora/do": "1.0.0-alpha.2",
        "@lunora/server": "1.0.0-alpha.1",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "drizzle-orm": "catalog:drizzle",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
