{
    "name": "@cirrus/codegen",
    "version": "0.0.0",
    "license": "FSL-1.1-Apache-2.0",
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "bench": "vitest bench --run"
    },
    "dependencies": {
        "@cirrus/advisor": "workspace:*",
        "@cirrus/scheduler": "workspace:*",
        "ts-morph": "catalog:tooling"
    },
    "devDependencies": {
        "@cirrus/do": "workspace:*",
        "@cirrus/server": "workspace:*",
        "@cirrus/values": "workspace:*",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "drizzle-orm": "catalog:drizzle",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
