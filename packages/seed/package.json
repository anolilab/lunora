{
    "name": "@lunora/seed",
    "version": "0.0.0",
    "description": "Schema-driven, deterministic database seeding for Lunora: realistic fake data from defineSchema",
    "keywords": [
        "cloudflare",
        "faker",
        "fixtures",
        "lunora",
        "seed"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/seed"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md",
        "__assets__"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./testing": {
            "types": "./dist/testing.d.ts",
            "import": "./dist/testing.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@faker-js/faker": "catalog:data"
    },
    "devDependencies": {
        "@lunora/do": "workspace:*",
        "@lunora/server": "workspace:*",
        "@lunora/testing": "workspace:*",
        "@lunora/values": "workspace:*",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@lunora/server": "workspace:*",
        "@lunora/values": "workspace:*"
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
