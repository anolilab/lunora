{
    "$schema": "../../../../node_modules/wrangler/config-schema.json",
    "name": "lunora-scheduler-test-worker",
    "main": "test-worker.ts",
    "compatibility_date": "2026-04-07",
    "compatibility_flags": ["nodejs_compat"],
    "durable_objects": {
        "bindings": [{ "name": "SCHEDULER", "class_name": "TestSchedulerDO" }],
    },
    // `handleSchedule()` refuses to enqueue (500 ORIGIN_NOT_CONFIGURED) unless
    // the dispatch origin is bound — it is read from env, never from the request
    // body (SSRF hardening). The test DO overrides `dispatch()`, so the value is
    // never fetched; it only has to be present.
    "vars": { "LUNORA_ORIGIN_URL": "https://app.test" },
    "migrations": [{ "tag": "v1", "new_classes": ["TestSchedulerDO"] }],
}
