{
    "name": "ratelimit",
    "description": "Token-bucket / fixed-window rate limiting",
    "requires": [],
    "deps": {
        "@lunora/ratelimit": "workspace:*"
    },
    "bindings": [
        {
            "path": ["vars", "RATELIMIT_ENABLED"],
            "value": "true"
        }
    ],
    "files": [
        { "from": "schema.ts", "to": "lunora/ratelimit/schema.ts", "merge": "schema-extension" },
        { "from": "ratelimit.ts", "to": "lunora/ratelimit/index.ts", "merge": "create-or-skip" }
    ]
}
