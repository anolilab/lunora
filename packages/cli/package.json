{
    "name": "@lunora/cli",
    "version": "0.0.0",
    "license": "FSL-1.1-Apache-2.0",
    "description": "The Lunora CLI: init, dev, deploy, codegen, run, reset, and migrate commands",
    "homepage": "https://lunora.sh",
    "bugs": {
        "url": "https://github.com/anolilab/lunora/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/cli"
    },
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "keywords": [
        "lunora",
        "cloudflare",
        "workers",
        "durable-objects",
        "cli",
        "codegen",
        "deploy",
        "vite",
        "tanstack-intent",
        "agent-skills"
    ],
    "bin": {
        "lunora": "./dist/bin.mjs"
    },
    "files": [
        "dist",
        "__assets__",
        "skills",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test:bench": "vitest bench --run --config vitest.bench.config.ts",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@bomb.sh/tab": "0.0.17",
        "@lunora/codegen": "workspace:*",
        "@lunora/config": "workspace:*",
        "@lunora/container": "workspace:*",
        "@lunora/d1": "workspace:*",
        "@lunora/seed": "workspace:*",
        "@lunora/server": "workspace:*",
        "@lunora/studio": "workspace:*",
        "@lunora/values": "workspace:*",
        "@visulima/cerebro": "3.0.0-alpha.31",
        "@visulima/fs": "5.0.0-alpha.31",
        "@visulima/pail": "4.0.0-alpha.21",
        "@visulima/path": "3.0.0-alpha.12",
        "@visulima/spinner": "1.0.0-alpha.3",
        "giget": "3.3.0",
        "jsonc-parser": "catalog:vite",
        "magic-string": "^0.30.21",
        "ts-morph": "catalog:tooling"
    },
    "devDependencies": {
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@codspeed/vitest-plugin": "catalog:test",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
