{
    "name": "@lunora/cli",
    "version": "1.0.0-alpha.218",
    "description": "The Lunora CLI: init, dev, deploy, codegen, migrate, seed, doctor, insights, logs, registry, and the rest of the project commands",
    "keywords": [
        "agent-skills",
        "cli",
        "cloudflare",
        "codegen",
        "deploy",
        "durable-objects",
        "lunora",
        "tanstack-intent",
        "vite",
        "workers"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/cli"
    },
    "bin": {
        "lunora": "./dist/bin.mjs"
    },
    "files": [
        "./dist",
        "__assets__",
        "skills",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint . --max-warnings=0",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test:bench": "vitest bench --run --config vitest.bench.config.ts",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@bomb.sh/tab": "catalog:cli",
        "@lunora/advisor": "1.0.0-alpha.106",
        "@lunora/bindings": "1.0.0-alpha.47",
        "@lunora/codegen": "1.0.0-alpha.151",
        "@lunora/config": "1.0.0-alpha.185",
        "@lunora/container": "1.0.0-alpha.41",
        "@lunora/d1": "1.0.0-alpha.104",
        "@lunora/errors": "1.0.0-alpha.30",
        "@lunora/mcp": "1.0.0-alpha.106",
        "@lunora/runtime": "1.0.0-alpha.89",
        "@lunora/seed": "1.0.0-alpha.102",
        "@visulima/cerebro": "catalog:cli",
        "@visulima/error": "catalog:prod",
        "@visulima/fs": "catalog:cli",
        "@visulima/pail": "catalog:cli",
        "@visulima/path": "catalog:cli",
        "@visulima/spinner": "catalog:cli",
        "@visulima/tui": "catalog:cli",
        "@visulima/tui-kit": "catalog:cli",
        "adm-zip": "catalog:prod",
        "cfonts": "catalog:cli",
        "csv-parse": "catalog:prod",
        "giget": "catalog:cli",
        "jsonc-parser": "catalog:vite",
        "magic-string": "catalog:cli",
        "react": "catalog:frontend",
        "react-reconciler": "catalog:cli",
        "smol-toml": "catalog:cli",
        "ts-morph": "catalog:tooling"
    },
    "devDependencies": {
        "@codspeed/vitest-plugin": "catalog:test",
        "@lunora/testing": "1.0.0-alpha.142",
        "@types/node": "catalog:types",
        "@types/react": "catalog:frontend",
        "@types/semver": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "fallow": "catalog:lint",
        "semver": "catalog:node",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "mysql2": "*",
        "pg": "*"
    },
    "peerDependenciesMeta": {
        "mysql2": {
            "optional": true
        },
        "pg": {
            "optional": true
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
