{
    "name": "@cirrus/cli",
    "version": "0.0.0",
    "license": "FSL-1.1-Apache-2.0",
    "description": "The Cirrus CLI: init, dev, deploy, codegen, run, reset, and migrate commands",
    "homepage": "https://cirrus.dev",
    "bugs": {
        "url": "https://github.com/anolilab/cirrus/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/cirrus.git",
        "directory": "packages/cli"
    },
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "keywords": [
        "cirrus",
        "cloudflare",
        "workers",
        "durable-objects",
        "cli",
        "codegen",
        "deploy",
        "vite"
    ],
    "bin": {
        "cirrus": "./dist/bin.mjs"
    },
    "files": [
        "dist",
        "__assets__",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "bench": "vitest bench --run",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@bomb.sh/tab": "0.0.15",
        "@cirrus/codegen": "workspace:*",
        "@cirrus/config": "workspace:*",
        "@cirrus/container": "workspace:*",
        "@cirrus/d1": "workspace:*",
        "@cirrus/studio": "workspace:*",
        "@visulima/cerebro": "3.0.0-alpha.31",
        "@visulima/fs": "5.0.0-alpha.31",
        "@visulima/pail": "4.0.0-alpha.21",
        "@visulima/path": "3.0.0-alpha.12",
        "@visulima/spinner": "1.0.0-alpha.3",
        "giget": "3.2.0",
        "jsonc-parser": "catalog:vite",
        "magic-string": "^0.30.21",
        "ts-morph": "catalog:tooling"
    },
    "devDependencies": {
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
