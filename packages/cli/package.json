{
    "name": "@cirrus/cli",
    "version": "0.0.0",
    "license": "FSL-1.1-Apache-2.0",
    "bin": {
        "cirrus": "./dist/bin.mjs"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "bench": "vitest bench --run",
        "test": "vitest run"
    },
    "dependencies": {
        "@cirrus/codegen": "workspace:*",
        "@cirrus/config": "workspace:*",
        "@cirrus/d1": "workspace:*",
        "@cirrus/studio": "workspace:*",
        "@visulima/boxen": "2.0.10",
        "@visulima/cerebro": "2.1.5",
        "@visulima/colorize": "1.4.29",
        "@visulima/fs": "4.1.0",
        "@visulima/pail": "3.2.2",
        "@visulima/path": "2.0.5",
        "giget": "3.2.0",
        "jsonc-parser": "catalog:vite",
        "magic-string": "^0.30.21",
        "ts-morph": "catalog:tooling"
    },
    "devDependencies": {
        "@cirrus/studio-host": "workspace:*",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
