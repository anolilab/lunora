{
    "name": "@lunora/server",
    "version": "0.0.0",
    "license": "FSL-1.1-Apache-2.0",
    "description": "Server primitives for Lunora: defineSchema, defineTable, query, mutation, and action",
    "homepage": "https://lunora.sh",
    "bugs": {
        "url": "https://github.com/anolilab/lunora/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/server"
    },
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "keywords": [
        "lunora",
        "cloudflare",
        "workers",
        "durable-objects",
        "schema",
        "query",
        "mutation",
        "backend"
    ],
    "files": [
        "dist",
        "README.md",
        "LICENSE.md",
        "__assets__"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./types": {
            "types": "./dist/types.d.ts",
            "import": "./dist/types.mjs"
        },
        "./drizzle": {
            "types": "./dist/drizzle.d.ts",
            "import": "./dist/drizzle.mjs"
        },
        "./data-model": {
            "types": "./dist/data-model.d.ts",
            "import": "./dist/data-model.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "bench": "vitest bench --run"
    },
    "dependencies": {
        "@lunora/scheduler": "workspace:*",
        "@lunora/values": "workspace:*",
        "drizzle-orm": "catalog:drizzle",
        "hono": "catalog:http"
    },
    "devDependencies": {
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
