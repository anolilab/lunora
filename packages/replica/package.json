{
    "name": "@lunora/replica",
    "version": "1.0.0-alpha.81",
    "description": "Local-first replica runtime + local SQLite mirror for Lunora",
    "keywords": [
        "cloudflare",
        "durable-objects",
        "event-sourcing",
        "local-first",
        "lunora",
        "replica",
        "sqlite",
        "sync",
        "workers"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/replica"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "import": "./dist/react.mjs"
        },
        "./adapters/sqljs": {
            "types": "./dist/adapters/sqljs.d.ts",
            "import": "./dist/adapters/sqljs.mjs"
        },
        "./adapters/better-sqlite3": {
            "types": "./dist/adapters/better-sqlite3.d.ts",
            "import": "./dist/adapters/better-sqlite3.mjs"
        },
        "./adapters/sqlite-wasm": {
            "types": "./dist/adapters/sqlite-wasm.d.ts",
            "import": "./dist/adapters/sqlite-wasm.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint . --max-warnings=0",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:bench": "vitest bench --run --config vitest.bench.config.ts",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@codspeed/vitest-plugin": "catalog:test",
        "@lunora/server": "1.0.0-alpha.102",
        "@testing-library/dom": "catalog:frontend",
        "@testing-library/react": "catalog:frontend",
        "@types/node": "catalog:types",
        "@types/react": "catalog:frontend",
        "@types/react-dom": "catalog:frontend",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "jsdom": "catalog:frontend",
        "react": "catalog:frontend",
        "react-dom": "catalog:frontend",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@lunora/server": ">=1.0.0-alpha.24 <2.0.0-0",
        "@sqlite.org/sqlite-wasm": "*",
        "better-sqlite3": "*",
        "react": "^18.0.0 || ^19.0.0",
        "sql.js": "^1.0.0"
    },
    "peerDependenciesMeta": {
        "@lunora/server": {
            "optional": true
        },
        "@sqlite.org/sqlite-wasm": {
            "optional": true
        },
        "better-sqlite3": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "sql.js": {
            "optional": true
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
