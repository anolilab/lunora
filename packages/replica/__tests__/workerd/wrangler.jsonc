// Minimal wrangler config used ONLY by `@cloudflare/vitest-plugin` to boot the
// test Worker in a real workerd runtime.
//
// IMPORTANT: this file is not deployed. It exists so the pool can resolve the
// EventLogDO class name and its SQLite migration the same way `wrangler dev`
// would.
{
    "$schema": "../../../../node_modules/wrangler/config-schema.json",
    "name": "lunora-replica-test-worker",
    "main": "test-worker.ts",
    "compatibility_date": "2026-04-07",
    "durable_objects": {
        "bindings": [{ "name": "EVENT_LOG_DO", "class_name": "EventLogDO" }],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventLogDO"] }],
}
