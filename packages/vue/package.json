{
    "name": "@cirrus/vue",
    "version": "0.0.0",
    "description": "Vue adapter for Cirrus — live composables, optimistic mutations, and reactive loaders",
    "license": "FSL-1.1-Apache-2.0",
    "homepage": "https://cirrus.dev",
    "bugs": {
        "url": "https://github.com/anolilab/cirrus/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/cirrus.git",
        "directory": "packages/vue"
    },
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "keywords": [
        "cirrus",
        "cloudflare",
        "workers",
        "durable-objects",
        "vue",
        "composables",
        "realtime",
        "optimistic-updates"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.mjs"
        },
        "./worker": {
            "types": "./dist/worker.d.ts",
            "import": "./dist/worker.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md",
        "__assets__"
    ],
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@cirrus/client": "workspace:*",
        "@cirrus/runtime": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "unplugin-vue": "catalog:build",
        "vitest": "catalog:test",
        "vue": "catalog:frontend"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "peerDependenciesMeta": {
        "vue": {
            "optional": false
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
