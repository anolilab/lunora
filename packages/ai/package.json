{
    "name": "@lunora/ai",
    "version": "1.0.0-alpha.70",
    "description": "Workers AI helper for Lunora: provider-agnostic AI SDK access from functions, Workers AI by default",
    "keywords": [
        "ai",
        "ai-sdk",
        "cloudflare",
        "embeddings",
        "inference",
        "llm",
        "lunora",
        "rag",
        "retrieval",
        "workers",
        "workers-ai"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/ai"
    },
    "files": [
        "./dist",
        "__assets__",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./rag": {
            "types": "./dist/rag/index.d.ts",
            "import": "./dist/rag/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "pnpm exec eslint . --max-warnings=0",
        "lint:eslint:fix": "pnpm exec eslint . --fix",
        "lint:prettier": "pnpm exec prettier --check .",
        "lint:prettier:fix": "pnpm exec prettier --write .",
        "lint:types": "pnpm exec tsc --noEmit",
        "test": "pnpm exec vitest run",
        "test:coverage": "pnpm exec vitest run --coverage",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@lunora/errors": "1.0.0-alpha.30",
        "ai": "catalog:ai",
        "workers-ai-provider": "catalog:ai"
    },
    "devDependencies": {
        "@ai-sdk/anthropic": "catalog:ai",
        "@ai-sdk/openai": "catalog:ai",
        "@cloudflare/vitest-plugin": "catalog:cloudflare",
        "@cloudflare/workers-types": "catalog:cloudflare",
        "@lunora/search-core": "workspace:*",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "fallow": "catalog:lint",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test",
        "wrangler": "catalog:cloudflare"
    },
    "peerDependencies": {
        "@ai-sdk/anthropic": "^4.0.0",
        "@ai-sdk/openai": "^4.0.0"
    },
    "peerDependenciesMeta": {
        "@ai-sdk/anthropic": {
            "optional": true
        },
        "@ai-sdk/openai": {
            "optional": true
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
