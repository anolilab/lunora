{
    "name": "@cirrus/ratelimit",
    "version": "0.0.0",
    "description": "Rate limiting: token-bucket / fixed-window / sliding-window algorithms, deny list, sharding, pluggable stores, and procedure middleware",
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build",
        "build:prod": "pnpm exec packem build",
        "lint:types": "pnpm exec tsc --noEmit",
        "test": "pnpm exec vitest run"
    },
    "devDependencies": {
        "@cirrus/server": "workspace:*",
        "@cirrus/values": "workspace:*",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    }
}
