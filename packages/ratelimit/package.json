{
    "name": "@cirrus/ratelimit",
    "version": "0.0.0",
    "description": "Rate limiting: token-bucket / fixed-window / sliding-window algorithms, deny list, sharding, pluggable stores, and procedure middleware",
    "license": "FSL-1.1-Apache-2.0",
    "homepage": "https://cirrus.dev",
    "bugs": {
        "url": "https://github.com/anolilab/cirrus/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/cirrus.git",
        "directory": "packages/ratelimit"
    },
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "keywords": [
        "cirrus",
        "cloudflare",
        "workers",
        "durable-objects",
        "rate-limit",
        "token-bucket",
        "sliding-window",
        "middleware"
    ],
    "files": [
        "dist",
        "__assets__",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "pnpm exec eslint .",
        "lint:eslint:fix": "pnpm exec eslint . --fix",
        "lint:prettier": "pnpm exec prettier --check .",
        "lint:prettier:fix": "pnpm exec prettier --write .",
        "lint:types": "pnpm exec tsc --noEmit",
        "test": "pnpm exec vitest run",
        "test:coverage": "pnpm exec vitest run --coverage",
        "bench": "pnpm exec vitest bench --run"
    },
    "devDependencies": {
        "@cirrus/server": "workspace:*",
        "@cirrus/values": "workspace:*",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
