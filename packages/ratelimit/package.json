{
    "name": "@lunora/ratelimit",
    "version": "1.0.0-alpha.41",
    "description": "Rate limiting: token-bucket / fixed-window / sliding-window algorithms, deny list, sharding, pluggable stores, and procedure middleware",
    "keywords": [
        "cloudflare",
        "durable-objects",
        "lunora",
        "middleware",
        "rate-limit",
        "sliding-window",
        "token-bucket",
        "workers"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/ratelimit"
    },
    "files": [
        "./dist",
        "__assets__",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "pnpm exec eslint . --max-warnings=0",
        "lint:eslint:fix": "pnpm exec eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "pnpm exec tsc --noEmit",
        "test": "pnpm exec vitest run",
        "test:coverage": "pnpm exec vitest run --coverage",
        "test:bench": "vitest bench --run --config vitest.bench.config.ts",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@lunora/errors": "1.0.0-alpha.33"
    },
    "devDependencies": {
        "@codspeed/vitest-plugin": "catalog:test",
        "@lunora/server": "1.0.0-alpha.105",
        "@lunora/values": "1.0.0-alpha.41",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "fallow": "catalog:lint",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@lunora/server": ">=1.0.0-alpha.24 <2.0.0-0",
        "@lunora/values": ">=1.0.0-alpha.7 <2.0.0-0"
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
