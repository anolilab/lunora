{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        // Intentionally no `outDir`/`rootDir`: this package imports `../../shared/*`
        // (bundler-inlined), and a set `rootDir` raises TS6059 for the
        // out-of-package file under `tsc --noEmit`.
        "moduleResolution": "bundler",
        "types": ["node"]
    },
    "include": ["src/**/*", "__tests__/**/*", "__bench__/**/*", "../../shared/**/*"]
}
