{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        // Intentionally no `outDir`/`rootDir`: this package imports `../../shared/*`
        // (bundler-inlined), and a set `rootDir` raises TS6059 for the
        // out-of-package file under `tsc --noEmit`.
        "moduleResolution": "bundler",
        "types": ["node"]
    },
    "include": ["src/**/*", "__tests__/**/*", "__bench__/**/*", "../../shared/**/*"],
    // The workerd suites need Cloudflare's ambient globals, and ambient types are
    // program-wide: listed here they would retype `src/` too (a global `Response`
    // whose `json<T>()` is generic), letting a Cloudflare-only type slip into
    // shipped code and still compile. They get their own program instead — see
    // `__tests__/workerd/tsconfig.json`, checked by `lint:types` as well.
    "exclude": ["__tests__/workerd/**"]
}
