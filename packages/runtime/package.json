{
    "name": "@lunora/runtime",
    "version": "1.0.0-alpha.94",
    "description": "Lunora Worker runtime: the RPC router, shard resolver, and query coordinator",
    "keywords": [
        "cloudflare",
        "durable-objects",
        "lunora",
        "query-coordinator",
        "rpc",
        "runtime",
        "sharding",
        "workers"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/runtime"
    },
    "files": [
        "./dist",
        "README.md",
        "LICENSE.md",
        "__assets__"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint . --max-warnings=0",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:bench": "vitest bench --run --config vitest.bench.config.ts",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@lunora/bindings": "1.0.0-alpha.50",
        "@lunora/errors": "1.0.0-alpha.32",
        "@lunora/observability": "1.0.0-alpha.57",
        "@lunora/platform": "1.0.0-alpha.26"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "catalog:cloudflare",
        "@cloudflare/workers-types": "catalog:cloudflare",
        "@codspeed/vitest-plugin": "catalog:test",
        "@lunora/do": "1.0.0-alpha.118",
        "@lunora/shard-engine": "1.0.0-alpha.56",
        "@lunora/workflow": "1.0.0-alpha.46",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "fallow": "catalog:lint",
        "hono": "catalog:http",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test",
        "wrangler": "catalog:cloudflare"
    },
    "peerDependencies": {
        "@lunora/shard-engine": ">=1.0.0-alpha.24 <2.0.0-0",
        "@lunora/workflow": ">=1.0.0-alpha.24 <2.0.0-0"
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
