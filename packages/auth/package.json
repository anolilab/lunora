{
    "name": "@lunora/auth",
    "version": "1.0.0-alpha.35",
    "description": "Auth for Lunora — a thin better-auth wrapper: email/password, OAuth, plugins, D1-backed",
    "keywords": [
        "auth",
        "better-auth",
        "cloudflare",
        "durable-objects",
        "lunora",
        "oauth",
        "session",
        "workers"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/auth"
    },
    "files": [
        "./dist",
        "__assets__",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./plugins": {
            "types": "./dist/plugins.d.ts",
            "import": "./dist/plugins.mjs"
        },
        "./plugins/client": {
            "types": "./dist/plugins-client.d.ts",
            "import": "./dist/plugins-client.mjs"
        },
        "./middleware": {
            "types": "./dist/middleware.d.ts",
            "import": "./dist/middleware.mjs"
        },
        "./turnstile": {
            "types": "./dist/turnstile.d.ts",
            "import": "./dist/turnstile.mjs"
        },
        "./turnstile-middleware": {
            "types": "./dist/turnstile-middleware.d.ts",
            "import": "./dist/turnstile-middleware.mjs"
        },
        "./schema": {
            "types": "./dist/schema.d.ts",
            "import": "./dist/schema.mjs"
        },
        "./adapter": {
            "types": "./dist/adapter.d.ts",
            "import": "./dist/adapter.mjs"
        },
        "./store": {
            "types": "./dist/store.d.ts",
            "import": "./dist/store.mjs"
        },
        "./sql-store": {
            "types": "./dist/sql-store.d.ts",
            "import": "./dist/sql-store.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@better-auth/passkey": "catalog:auth",
        "@lunora/errors": "1.0.0-alpha.6",
        "@lunora/server": "1.0.0-alpha.29",
        "@lunora/values": "1.0.0-alpha.9",
        "better-auth": "catalog:auth"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "catalog:cloudflare",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "fallow": "catalog:lint",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
