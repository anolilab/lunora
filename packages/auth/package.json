{
    "name": "@lunora/auth",
    "version": "0.0.0",
    "license": "FSL-1.1-Apache-2.0",
    "description": "Cookie-session auth for Lunora: PBKDF2 email/password plus OAuth (PKCE), D1-backed, sessions in SessionDO",
    "homepage": "https://lunora.sh",
    "bugs": {
        "url": "https://github.com/anolilab/lunora/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/auth"
    },
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "keywords": [
        "lunora",
        "cloudflare",
        "workers",
        "durable-objects",
        "auth",
        "better-auth",
        "oauth",
        "session"
    ],
    "files": [
        "dist",
        "__assets__",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./plugins": {
            "types": "./dist/plugins.d.ts",
            "import": "./dist/plugins.mjs"
        },
        "./middleware": {
            "types": "./dist/middleware.d.ts",
            "import": "./dist/middleware.mjs"
        },
        "./turnstile": {
            "types": "./dist/turnstile.d.ts",
            "import": "./dist/turnstile.mjs"
        },
        "./turnstile-middleware": {
            "types": "./dist/turnstile-middleware.d.ts",
            "import": "./dist/turnstile-middleware.mjs"
        },
        "./schema": {
            "types": "./dist/schema.d.ts",
            "import": "./dist/schema.mjs"
        },
        "./adapter": {
            "types": "./dist/adapter.d.ts",
            "import": "./dist/adapter.mjs"
        },
        "./store": {
            "types": "./dist/store.d.ts",
            "import": "./dist/store.mjs"
        },
        "./sql-store": {
            "types": "./dist/sql-store.d.ts",
            "import": "./dist/sql-store.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@better-auth/passkey": "catalog:auth",
        "@lunora/server": "workspace:*",
        "@lunora/values": "workspace:*",
        "better-auth": "catalog:auth"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "catalog:cloudflare",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
