{
    "name": "@cirrus/auth",
    "version": "0.0.0",
    "license": "FSL-1.1-Apache-2.0",
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./plugins": {
            "types": "./dist/plugins.d.ts",
            "import": "./dist/plugins.mjs"
        },
        "./middleware": {
            "types": "./dist/middleware.d.ts",
            "import": "./dist/middleware.mjs"
        },
        "./schema": {
            "types": "./dist/schema.d.ts",
            "import": "./dist/schema.mjs"
        },
        "./adapter": {
            "types": "./dist/adapter.d.ts",
            "import": "./dist/adapter.mjs"
        },
        "./store": {
            "types": "./dist/store.d.ts",
            "import": "./dist/store.mjs"
        },
        "./sql-store": {
            "types": "./dist/sql-store.d.ts",
            "import": "./dist/sql-store.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@better-auth/passkey": "catalog:auth",
        "@cirrus/server": "workspace:*",
        "@cirrus/values": "workspace:*",
        "better-auth": "catalog:auth"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "catalog:cloudflare",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
