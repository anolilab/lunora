{
    "name": "cirrus-{{dashCase name}}",
    "tags": [
        "type:package",
        "category:{{category}}"
    ],
    "targets": {
        "lint:eslint": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "{projectRoot}",
                "command": "eslint --config {workspaceRoot}/eslint.config.js ."
            },
            "cache": true,
            "inputs": [
                "default",
                "{workspaceRoot}/eslint.config.js"
            ]
        },
        "lint:eslint:fix": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "{projectRoot}",
                "command": "eslint --config {workspaceRoot}/eslint.config.js . --fix"
            },
            "cache": true,
            "inputs": [
                "default",
                "{workspaceRoot}/eslint.config.js"
            ]
        }
    }
}
