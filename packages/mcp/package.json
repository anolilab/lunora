{
    "name": "@lunora/mcp",
    "version": "1.0.0-alpha.110",
    "description": "Model Context Protocol server exposing a Lunora deployment to AI agents",
    "keywords": [
        "ai-agents",
        "cloudflare",
        "durable-objects",
        "llm",
        "lunora",
        "mcp",
        "model-context-protocol",
        "workers"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/mcp"
    },
    "bin": {
        "lunora-mcp": "./dist/bin.mjs"
    },
    "files": [
        "./dist",
        "__assets__",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./docs": {
            "types": "./dist/docs/index.d.ts",
            "import": "./dist/docs/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "packem build --development",
        "build:prod": "packem build --production",
        "lint:eslint": "eslint . --max-warnings=0",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@lunora/client": "1.0.0-alpha.75",
        "@lunora/errors": "1.0.0-alpha.31",
        "@lunora/shard-engine": "1.0.0-alpha.55",
        "@modelcontextprotocol/sdk": "catalog:mcp"
    },
    "devDependencies": {
        "@lunora/x402": "1.0.0-alpha.51",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "fallow": "catalog:lint",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@lunora/x402": ">=1.0.0-alpha.21 <2.0.0-0"
    },
    "peerDependenciesMeta": {
        "@lunora/x402": {
            "optional": true
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
