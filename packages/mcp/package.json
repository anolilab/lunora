{
    "name": "@cirrus/mcp",
    "version": "0.0.0",
    "license": "FSL-1.1-Apache-2.0",
    "description": "Model Context Protocol server exposing a Cirrus deployment to AI agents",
    "bin": {
        "cirrus-mcp": "./dist/bin.mjs"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "packem build --development",
        "build:prod": "packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@cirrus/client": "workspace:*",
        "@modelcontextprotocol/sdk": "catalog:mcp"
    },
    "devDependencies": {
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
