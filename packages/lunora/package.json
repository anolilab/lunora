{
    "name": "lunorash",
    "version": "1.0.0-alpha.224",
    "description": "The Lunora umbrella package: one install for the server authoring API, worker runtime, Durable Objects, and the lunora CLI",
    "keywords": [
        "backend",
        "cloudflare",
        "durable-objects",
        "framework",
        "lunora",
        "realtime",
        "workers"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/lunora"
    },
    "bin": {
        "lunora": "./dist/bin.mjs"
    },
    "files": [
        "./dist",
        "README.md",
        "LICENSE.md",
        "__assets__"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.mjs"
        },
        "./server/types": {
            "types": "./dist/server/types.d.ts",
            "import": "./dist/server/types.mjs"
        },
        "./server/data-model": {
            "types": "./dist/server/data-model.d.ts",
            "import": "./dist/server/data-model.mjs"
        },
        "./server/drizzle": {
            "types": "./dist/server/drizzle.d.ts",
            "import": "./dist/server/drizzle.mjs"
        },
        "./server/rls/testing": {
            "types": "./dist/server/rls/testing.d.ts",
            "import": "./dist/server/rls/testing.mjs"
        },
        "./server/otel": {
            "types": "./dist/server/otel.d.ts",
            "import": "./dist/server/otel.mjs"
        },
        "./values": {
            "types": "./dist/values.d.ts",
            "import": "./dist/values.mjs"
        },
        "./errors": {
            "types": "./dist/errors.d.ts",
            "import": "./dist/errors.mjs"
        },
        "./runtime": {
            "types": "./dist/runtime.d.ts",
            "import": "./dist/runtime.mjs"
        },
        "./do": {
            "types": "./dist/do.d.ts",
            "import": "./dist/do.mjs"
        },
        "./platform": {
            "types": "./dist/platform.d.ts",
            "import": "./dist/platform.mjs"
        },
        "./observability": {
            "types": "./dist/observability.d.ts",
            "import": "./dist/observability.mjs"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.mjs"
        },
        "./client/query": {
            "types": "./dist/client/query.d.ts",
            "import": "./dist/client/query.mjs"
        },
        "./client/auth": {
            "types": "./dist/client/auth.d.ts",
            "import": "./dist/client/auth.mjs"
        },
        "./client/pagination": {
            "types": "./dist/client/pagination.d.ts",
            "import": "./dist/client/pagination.mjs"
        },
        "./client/ssr": {
            "types": "./dist/client/ssr.d.ts",
            "import": "./dist/client/ssr.mjs"
        },
        "./client/upload": {
            "types": "./dist/client/upload.d.ts",
            "import": "./dist/client/upload.mjs"
        },
        "./client/service": {
            "types": "./dist/client/service.d.ts",
            "import": "./dist/client/service.mjs"
        },
        "./flags": {
            "types": "./dist/flags.d.ts",
            "import": "./dist/flags.mjs"
        },
        "./flags/env": {
            "types": "./dist/flags/env.d.ts",
            "import": "./dist/flags/env.mjs"
        },
        "./flags/flagship": {
            "types": "./dist/flags/flagship.d.ts",
            "import": "./dist/flags/flagship.mjs"
        },
        "./flags/memory": {
            "types": "./dist/flags/memory.d.ts",
            "import": "./dist/flags/memory.mjs"
        },
        "./flags/web": {
            "types": "./dist/flags/web.d.ts",
            "import": "./dist/flags/web.mjs"
        },
        "./ratelimit": {
            "types": "./dist/ratelimit.d.ts",
            "import": "./dist/ratelimit.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint . --max-warnings=0",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@lunora/cli": "1.0.0-alpha.221",
        "@lunora/client": "1.0.0-alpha.74",
        "@lunora/do": "1.0.0-alpha.116",
        "@lunora/errors": "1.0.0-alpha.30",
        "@lunora/flags": "1.0.0-alpha.43",
        "@lunora/observability": "1.0.0-alpha.55",
        "@lunora/platform": "1.0.0-alpha.25",
        "@lunora/ratelimit": "1.0.0-alpha.37",
        "@lunora/runtime": "1.0.0-alpha.90",
        "@lunora/server": "1.0.0-alpha.101",
        "@lunora/values": "1.0.0-alpha.38"
    },
    "devDependencies": {
        "@codspeed/vitest-plugin": "catalog:test",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "fallow": "catalog:lint",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
