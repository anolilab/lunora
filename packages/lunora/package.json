{
    "name": "lunora",
    "version": "0.0.0",
    "license": "FSL-1.1-Apache-2.0",
    "description": "The Lunora umbrella package: one install for the server authoring API, worker runtime, Durable Objects, and the lunora CLI",
    "homepage": "https://lunora.sh",
    "bugs": {
        "url": "https://github.com/anolilab/lunora/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/lunora"
    },
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "keywords": [
        "lunora",
        "cloudflare",
        "workers",
        "durable-objects",
        "realtime",
        "backend",
        "framework"
    ],
    "files": [
        "dist",
        "README.md",
        "LICENSE.md",
        "__assets__"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "bin": {
        "lunora": "./dist/bin.mjs"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.mjs"
        },
        "./server/types": {
            "types": "./dist/server/types.d.ts",
            "import": "./dist/server/types.mjs"
        },
        "./server/data-model": {
            "types": "./dist/server/data-model.d.ts",
            "import": "./dist/server/data-model.mjs"
        },
        "./server/drizzle": {
            "types": "./dist/server/drizzle.d.ts",
            "import": "./dist/server/drizzle.mjs"
        },
        "./server/rls/testing": {
            "types": "./dist/server/rls/testing.d.ts",
            "import": "./dist/server/rls/testing.mjs"
        },
        "./values": {
            "types": "./dist/values.d.ts",
            "import": "./dist/values.mjs"
        },
        "./runtime": {
            "types": "./dist/runtime.d.ts",
            "import": "./dist/runtime.mjs"
        },
        "./do": {
            "types": "./dist/do.d.ts",
            "import": "./dist/do.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@lunora/cli": "workspace:*",
        "@lunora/do": "workspace:*",
        "@lunora/runtime": "workspace:*",
        "@lunora/server": "workspace:*",
        "@lunora/values": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@codspeed/vitest-plugin": "catalog:test",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
