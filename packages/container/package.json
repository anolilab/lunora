{
    "name": "@cirrus/container",
    "version": "0.0.0",
    "description": "Cloudflare Containers for Cirrus: defineContainer, generated Container DO classes, and the ctx.containers action surface",
    "license": "FSL-1.1-Apache-2.0",
    "homepage": "https://cirrus.dev",
    "bugs": {
        "url": "https://github.com/anolilab/cirrus/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/cirrus.git",
        "directory": "packages/container"
    },
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "keywords": [
        "cirrus",
        "cloudflare",
        "workers",
        "containers",
        "docker",
        "durable-objects"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./do": {
            "types": "./dist/do/index.d.ts",
            "import": "./dist/do/index.mjs"
        },
        "./bridge": {
            "types": "./dist/bridge.d.ts",
            "import": "./dist/bridge.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@cloudflare/containers": "catalog:cloudflare"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "catalog:cloudflare",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
