{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "types": ["node"]
        // No `outDir`/`rootDir`: this package is a source-of-truth synced into the
        // registry (never built/published), so `lint:types` is `tsc --noEmit` only —
        // neither is load-bearing. Mirrors packages/react/tsconfig.json.
    },
    "include": ["src/**/*", "__tests__/**/*"],
    // The non-React ports are copy-only templates in framework dialects tsc can't
    // check here (Solid's JSX runtime differs from react-jsx; Vue/Svelte SFCs and
    // Angular decorators need their own toolchains). They're type-checked in the
    // consumer's project after `lunora add auth-ui`. `core/` (shared) + `react/`
    // are the type-checked reference.
    "exclude": ["src/vue/**", "src/svelte/**", "src/solid/**", "src/angular/**"]
}
