{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        // The Angular port uses TS decorators, and Angular's JIT compiler (which
        // the Angular test project relies on) reads legacy decorator metadata.
        // Being in this program is also how the test transform learns to emit
        // them rather than standard decorators.
        "experimentalDecorators": true,
        "types": ["node"]
        // No `outDir`/`rootDir`: this package is a source-of-truth synced into the
        // registry (never built/published), so `lint:types` is `tsc --noEmit` only —
        // neither is load-bearing. Mirrors packages/react/tsconfig.json.
    },
    "include": ["src/**/*", "__tests__/**/*"],
    // This program covers `core/`, `react/` and `angular/` (plain `.ts` with
    // inline templates). The Solid port has its own program — `tsconfig.solid.json`
    // — because one program can hold only one `jsx`/`jsxImportSource` pair and
    // this one is React's; `lint:types` runs both.
    //
    // Vue and Svelte SFCs still need `vue-tsc` / `svelte-check`, separate
    // toolchains rather than another tsconfig, so those two remain copy-only
    // templates checked in the consumer's project after `lunora add auth-ui`.
    "exclude": [
        "src/vue/**",
        "src/svelte/**",
        "src/solid/**",
        // Their tests too: an included test importing an excluded port would pull
        // it straight back into the program.
        "__tests__/vue/**",
        "__tests__/svelte/**",
        "__tests__/solid/**"
    ]
}
