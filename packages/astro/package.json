{
    "name": "@cirrus/astro",
    "version": "0.0.0",
    "description": "Astro integration for Cirrus — single-worker composition + reactive-loader server helpers",
    "license": "FSL-1.1-Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@cirrus/runtime": "workspace:*",
        "@cirrus/ssr": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "astro": "^6.0.0"
    },
    "peerDependenciesMeta": {
        "astro": {
            "optional": true
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
