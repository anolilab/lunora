{
    "name": "@lunora/studio",
    "version": "1.0.0-alpha.160",
    "description": "The Lunora Studio: a local admin UI for your schema, data, logs, and advisors",
    "keywords": [
        "admin-ui",
        "cloudflare",
        "dashboard",
        "durable-objects",
        "lunora",
        "react",
        "studio",
        "workers"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/studio"
    },
    "files": [
        "./dist",
        "src/theme.css",
        "README.md",
        "LICENSE.md",
        "__assets__"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./mount": {
            "types": "./dist/mount.d.ts",
            "import": "./dist/mount.mjs"
        },
        "./styles.css": "./dist/styles.css",
        "./standalone/studio.js": "./dist/standalone/studio.js",
        "./theme.css": "./src/theme.css",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "pnpm --filter @lunora/studio-app dev",
        "dev:mock": "pnpm --filter @lunora/studio-app dev --open /mock.html",
        "build": "pnpm exec packem build --development && pnpm run build:css && pnpm run build:standalone",
        "build:css": "pnpm exec tailwindcss --input ./src/styles.css --output ./dist/styles.css --minify",
        "build:standalone": "node ./scripts/build-standalone.mjs",
        "build:prod": "pnpm exec packem build --production && pnpm run build:css && pnpm run build:standalone",
        "lint:eslint": "eslint . --max-warnings=0",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --project unit --coverage",
        "test:unit": "vitest run --project unit",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@base-ui/react": "catalog:ui",
        "@hugeicons/core-free-icons": "catalog:ui",
        "@hugeicons/react": "catalog:ui",
        "@lingui/core": "catalog:i18n",
        "@lingui/message-utils": "catalog:i18n",
        "@lunora/advisor": "1.0.0-alpha.114",
        "@lunora/bindings": "1.0.0-alpha.53",
        "@lunora/client": "1.0.0-alpha.83",
        "@lunora/errors": "1.0.0-alpha.34",
        "@lunora/react": "1.0.0-alpha.89",
        "@tanstack/react-query": "catalog:frontend",
        "@tanstack/react-router": "catalog:frontend",
        "@tanstack/react-table": "catalog:frontend",
        "@tanstack/react-virtual": "catalog:frontend",
        "@xyflow/react": "catalog:frontend",
        "class-variance-authority": "catalog:ui",
        "clsx": "catalog:ui",
        "html-to-image": "catalog:frontend",
        "motion": "catalog:frontend",
        "recharts": "catalog:frontend",
        "tailwind-merge": "catalog:ui"
    },
    "devDependencies": {
        "@babel/core": "catalog:build",
        "@babel/preset-react": "catalog:build",
        "@lunora/mail": "1.0.0-alpha.66",
        "@lunora/notify": "1.0.0-alpha.41",
        "@lunora/runtime": "1.0.0-alpha.98",
        "@tailwindcss/cli": "catalog:vite",
        "@testing-library/dom": "catalog:frontend",
        "@testing-library/react": "catalog:frontend",
        "@types/node": "catalog:types",
        "@types/react": "catalog:frontend",
        "@types/react-dom": "catalog:frontend",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "babel-plugin-react-compiler": "catalog:build",
        "esbuild": "catalog:build",
        "fallow": "catalog:lint",
        "jsdom": "catalog:frontend",
        "react": "catalog:frontend",
        "react-dom": "catalog:frontend",
        "shadcn": "catalog:ui",
        "tailwindcss": "catalog:vite",
        "tw-animate-css": "catalog:vite",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@lunora/mail": ">=1.0.0-alpha.53 <2.0.0-0",
        "@lunora/runtime": ">=1.0.0-alpha.78 <2.0.0-0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": false
        },
        "react-dom": {
            "optional": false
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
