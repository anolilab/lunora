// Minimal wrangler config used ONLY by `@cloudflare/vitest-pool-workers`
// to boot the test Worker in a real workerd runtime.
//
// IMPORTANT: this file is not deployed. It exists so the pool can resolve the
// queue producer binding + push consumer the same way `wrangler dev` would.
{
    "$schema": "../../../../node_modules/wrangler/config-schema.json",
    "name": "lunora-queue-test-worker",
    "main": "test-worker.ts",
    "compatibility_date": "2026-04-07",
    "compatibility_flags": ["nodejs_compat"],
    "queues": {
        "producers": [{ "binding": "QUEUE_SMOKE_QUEUE", "queue": "smoke-queue" }],
        // `max_batch_timeout: 0` so a produced message is delivered to the
        // worker's `queue()` consumer immediately instead of after the default
        // batching window — keeps the end-to-end test fast and deterministic.
        "consumers": [{ "queue": "smoke-queue", "max_batch_size": 5, "max_batch_timeout": 0 }],
    },
}
