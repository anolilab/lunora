{
    "name": "@cirrus/do",
    "version": "0.0.0",
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build",
        "build:prod": "pnpm exec packem build",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "bench": "vitest bench --run"
    },
    "dependencies": {
        "drizzle-orm": "catalog:drizzle"
    },
    "devDependencies": {
        "@cirrus/vectors": "workspace:*",
        "@cloudflare/vitest-pool-workers": "catalog:cloudflare",
        "@cloudflare/workers-types": "catalog:cloudflare",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test",
        "wrangler": "catalog:cloudflare"
    }
}
