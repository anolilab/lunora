{
    "name": "@lunora/do",
    "version": "0.0.0",
    "license": "FSL-1.1-Apache-2.0",
    "description": "Lunora Durable Objects: ShardDO (SQLite, OCC, hibernated WebSocket subscriptions) and SessionDO",
    "homepage": "https://lunora.sh",
    "bugs": {
        "url": "https://github.com/anolilab/lunora/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/do"
    },
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "keywords": [
        "lunora",
        "cloudflare",
        "workers",
        "durable-objects",
        "sqlite",
        "websocket",
        "hibernation",
        "shard"
    ],
    "files": [
        "dist",
        "README.md",
        "LICENSE.md",
        "__assets__"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:bench": "vitest bench --run --config vitest.bench.config.ts"
    },
    "dependencies": {
        "@visulima/redact": "catalog:redact",
        "drizzle-orm": "catalog:drizzle"
    },
    "devDependencies": {
        "@lunora/vectors": "workspace:*",
        "@cloudflare/vitest-pool-workers": "catalog:cloudflare",
        "@cloudflare/workers-types": "catalog:cloudflare",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@codspeed/vitest-plugin": "catalog:test",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test",
        "wrangler": "catalog:cloudflare"
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
