// Minimal wrangler config used ONLY by `@cloudflare/vitest-pool-workers`
// to boot the test Worker in a real workerd runtime.
//
// IMPORTANT: this file is not deployed. It exists so the pool can resolve
// Durable Object class names, compatibility flags, and SQLite migrations
// the same way `wrangler dev` would.
{
    "$schema": "../../../../node_modules/wrangler/config-schema.json",
    "name": "lunora-do-test-worker",
    "main": "test-worker.ts",
    "compatibility_date": "2026-04-07",
    "compatibility_flags": ["nodejs_compat"],
    "durable_objects": {
        "bindings": [
            { "name": "SHARD", "class_name": "TestShardDO" },
            { "name": "SESSION", "class_name": "TestSessionDO" },
            { "name": "SYNC", "class_name": "TestSyncDO" },
            { "name": "ECHO", "class_name": "TestEchoDO" },
        ],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestShardDO", "TestSessionDO", "TestSyncDO", "TestEchoDO"] }],
}
