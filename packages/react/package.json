{
    "name": "@lunora/react",
    "version": "1.0.0-alpha.84",
    "description": "React hooks for Lunora: useQuery, useMutation, useSubscription, and useAuth",
    "keywords": [
        "cloudflare",
        "durable-objects",
        "hooks",
        "lunora",
        "react",
        "realtime",
        "usequery",
        "workers"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/react"
    },
    "files": [
        "./dist",
        "README.md",
        "LICENSE.md",
        "__assets__"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./payment": {
            "types": "./dist/payment.d.ts",
            "import": "./dist/payment.mjs"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.mjs"
        },
        "./upload": {
            "types": "./dist/upload.d.ts",
            "import": "./dist/upload.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "test:bench": "vitest bench --run --config vitest.bench.config.ts",
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:doctor": "react-doctor",
        "lint:eslint": "eslint . --max-warnings=0",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@lunora/client": "1.0.0-alpha.79",
        "@lunora/errors": "1.0.0-alpha.32",
        "@lunora/ratelimit": "1.0.0-alpha.39",
        "@visulima/storage-client": "catalog:storage"
    },
    "devDependencies": {
        "@babel/core": "catalog:build",
        "@babel/preset-react": "catalog:build",
        "@codspeed/vitest-plugin": "catalog:test",
        "@tanstack/react-query": "catalog:frontend",
        "@testing-library/dom": "catalog:frontend",
        "@testing-library/react": "catalog:frontend",
        "@types/node": "catalog:types",
        "@types/react": "catalog:frontend",
        "@types/react-dom": "catalog:frontend",
        "@visulima/packem": "catalog:build",
        "@visulima/storage": "catalog:storage",
        "@vitest/coverage-v8": "catalog:test",
        "babel-plugin-react-compiler": "catalog:build",
        "esbuild": "catalog:build",
        "fallow": "catalog:lint",
        "jsdom": "catalog:frontend",
        "react": "catalog:frontend",
        "react-doctor": "catalog:lint",
        "react-dom": "catalog:frontend",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5.101.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "peerDependenciesMeta": {
        "@tanstack/react-query": {
            "optional": false
        },
        "react": {
            "optional": false
        },
        "react-dom": {
            "optional": true
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
