{
    "name": "@cirrus/react",
    "version": "0.0.0",
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    },
    "sideEffects": false,
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build",
        "build:prod": "pnpm exec packem build",
        "lint:doctor": "react-doctor",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@cirrus/client": "workspace:*",
        "@cirrus/ratelimit": "workspace:*"
    },
    "devDependencies": {
        "@tanstack/react-query": "catalog:frontend",
        "@testing-library/dom": "catalog:frontend",
        "@testing-library/react": "catalog:frontend",
        "@types/node": "catalog:types",
        "@types/react": "catalog:frontend",
        "@types/react-dom": "catalog:frontend",
        "@visulima/packem": "catalog:build",
        "esbuild": "catalog:build",
        "jsdom": "catalog:frontend",
        "react": "catalog:frontend",
        "react-doctor": "0.2.14",
        "react-dom": "catalog:frontend",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5.100.14",
        "react": "^19.2.6",
        "react-dom": "^19.2.6"
    },
    "peerDependenciesMeta": {
        "@tanstack/react-query": {
            "optional": false
        },
        "react": {
            "optional": false
        },
        "react-dom": {
            "optional": false
        }
    }
}
