{
    "name": "@lunora/react",
    "version": "0.0.0",
    "license": "FSL-1.1-Apache-2.0",
    "description": "React hooks for Lunora: useQuery, useMutation, useSubscription, and useAuth",
    "homepage": "https://lunora.sh",
    "bugs": {
        "url": "https://github.com/anolilab/lunora/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/react"
    },
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "keywords": [
        "lunora",
        "cloudflare",
        "workers",
        "durable-objects",
        "react",
        "hooks",
        "usequery",
        "realtime"
    ],
    "files": [
        "dist",
        "README.md",
        "LICENSE.md",
        "__assets__"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "test:bench": "vitest bench --run --config vitest.bench.config.ts",
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:doctor": "react-doctor",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@lunora/client": "workspace:*",
        "@lunora/ratelimit": "workspace:*"
    },
    "devDependencies": {
        "@babel/core": "catalog:build",
        "@babel/preset-react": "catalog:build",
        "@tanstack/react-query": "catalog:frontend",
        "@testing-library/dom": "catalog:frontend",
        "@testing-library/react": "catalog:frontend",
        "@types/node": "catalog:types",
        "@types/react": "catalog:frontend",
        "@types/react-dom": "catalog:frontend",
        "@visulima/packem": "catalog:build",
        "@codspeed/vitest-plugin": "catalog:test",
        "@vitest/coverage-v8": "catalog:test",
        "babel-plugin-react-compiler": "catalog:build",
        "esbuild": "catalog:build",
        "jsdom": "catalog:frontend",
        "react": "catalog:frontend",
        "react-doctor": "0.5.6",
        "react-dom": "catalog:frontend",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5.101.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "peerDependenciesMeta": {
        "@tanstack/react-query": {
            "optional": false
        },
        "react": {
            "optional": false
        },
        "react-dom": {
            "optional": false
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
