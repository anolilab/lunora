{
    "name": "@cirrus/react",
    "version": "0.0.0",
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
