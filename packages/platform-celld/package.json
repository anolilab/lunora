{
    "name": "@lunora/platform-celld",
    "version": "1.0.0-alpha.4",
    "description": "celld implementation of the Lunora platform contracts: the Cloudflare host adapters recomposed for celld (self-hosted distributed Durable Objects) under an honest capability matrix",
    "keywords": [
        "celld",
        "deno",
        "durable-objects",
        "lunora",
        "platform",
        "portability"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/platform-celld"
    },
    "files": [
        "./dist",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint . --max-warnings=0",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@lunora/platform": "1.0.0-alpha.59",
        "@lunora/platform-cloudflare": "1.0.0-alpha.80"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "catalog:cloudflare",
        "@codspeed/vitest-plugin": "catalog:test",
        "@lunora/agent": "1.0.0-alpha.196",
        "@lunora/ai": "1.0.0-alpha.122",
        "@lunora/bindings": "1.0.0-alpha.104",
        "@lunora/container": "1.0.0-alpha.72",
        "@lunora/d1": "1.0.0-alpha.170",
        "@lunora/queue": "1.0.0-alpha.98",
        "@lunora/shard-engine": "1.0.0-alpha.120",
        "@lunora/storage": "1.0.0-alpha.125",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "@vitest/expect": "catalog:test",
        "esbuild": "catalog:build",
        "fallow": "catalog:lint",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
