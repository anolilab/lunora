{
    "name": "@cirrus/d1",
    "version": "0.0.0",
    "license": "FSL-1.1-Apache-2.0",
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./dialect": {
            "types": "./dist/dialect.d.ts",
            "import": "./dist/dialect.mjs",
            "require": "./dist/dialect.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "bench": "vitest bench --run"
    },
    "dependencies": {
        "@cirrus/do": "workspace:*",
        "drizzle-orm": "catalog:drizzle"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "catalog:cloudflare",
        "@cloudflare/workers-types": "catalog:cloudflare",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test",
        "wrangler": "catalog:cloudflare"
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
