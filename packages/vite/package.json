{
    "name": "@lunora/vite",
    "version": "1.0.0-alpha.182",
    "description": "The Lunora Vite plugin: codegen, type sync, wrangler validation, and an error overlay over @cloudflare/vite-plugin",
    "keywords": [
        "cloudflare",
        "codegen",
        "durable-objects",
        "lunora",
        "vite",
        "vite-plugin",
        "workers",
        "wrangler"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/vite"
    },
    "files": [
        "./dist",
        "__assets__",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint . --max-warnings=0",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@cloudflare/vite-plugin": "catalog:vite",
        "@lunora/codegen": "1.0.0-alpha.148",
        "@lunora/config": "1.0.0-alpha.182",
        "@lunora/errors": "1.0.0-alpha.28",
        "@visulima/vite-overlay": "catalog:vite"
    },
    "devDependencies": {
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "fallow": "catalog:lint",
        "jsonc-parser": "catalog:vite",
        "ts-morph": "catalog:tooling",
        "typescript": "catalog:tsc",
        "vite": "catalog:vite",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@lunora/studio": ">=1.0.0-alpha.50 <2.0.0-0",
        "vite": "^6.1.0 || ^7.0.0 || ^8.0.0"
    },
    "peerDependenciesMeta": {
        "@lunora/studio": {
            "optional": true
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
