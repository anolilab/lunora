{
    "name": "@cirrus/vite",
    "version": "0.0.0",
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build",
        "build:prod": "pnpm exec packem build",
        "lint:types": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@cirrus/codegen": "workspace:*",
        "@cirrus/config": "workspace:*",
        "@cloudflare/vite-plugin": "catalog:vite",
        "jsonc-parser": "catalog:vite",
        "ts-morph": "catalog:tooling"
    },
    "devDependencies": {
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@visulima/vite-overlay": "catalog:vite",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vite": "catalog:vite",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@visulima/vite-overlay": "catalog:vite",
        "vite": "catalog:vite"
    },
    "peerDependenciesMeta": {
        "@visulima/vite-overlay": {
            "optional": true
        }
    }
}
