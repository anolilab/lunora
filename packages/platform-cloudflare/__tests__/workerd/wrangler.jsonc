// Boots the test worker in real workerd for `@cloudflare/vitest-pool-workers`.
// Not deployed — it exists so the pool can resolve DO class names, SQLite
// migrations, and the origin the SchedulerDO dispatches against.
{
    "$schema": "../../../../node_modules/wrangler/config-schema.json",
    "name": "lunora-platform-cloudflare-test-worker",
    "main": "test-worker.ts",
    "compatibility_date": "2026-04-07",
    "compatibility_flags": ["nodejs_compat"],
    "vars": { "LUNORA_ORIGIN_URL": "https://worker.test" },
    "durable_objects": {
        "bindings": [
            { "name": "SHARD", "class_name": "TestShardDO" },
            { "name": "ECHO", "class_name": "TestEchoDO" },
            { "name": "SCHEDULER", "class_name": "TestSchedulerDO" },
        ],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestShardDO", "TestEchoDO", "TestSchedulerDO"] }],
}
