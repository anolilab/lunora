{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        // Intentionally no `outDir`/`rootDir`, matching `do`/`shard-engine`:
        // `lint:types` is `tsc --noEmit` and packem owns the emit, so neither is
        // load-bearing — and a set `rootDir` raises TS6059 for `__tests__`.
        "moduleResolution": "bundler",
        "types": ["node", "@cloudflare/workers-types"]
    },
    "include": ["src/**/*", "__tests__/**/*"]
}
