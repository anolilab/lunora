{
    "name": "@cirrus/config",
    "version": "0.0.0",
    "license": "FSL-1.1-Apache-2.0",
    "description": "Internal shared CLI + Vite config layer for Cirrus: wrangler.jsonc validation, binding inference, and .dev.vars scaffolding",
    "homepage": "https://cirrus.dev",
    "bugs": {
        "url": "https://github.com/anolilab/cirrus/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/cirrus.git",
        "directory": "packages/config"
    },
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "keywords": [
        "cirrus",
        "cloudflare",
        "workers",
        "durable-objects",
        "wrangler",
        "config",
        "dev-vars",
        "bindings"
    ],
    "files": [
        "dist",
        "__assets__",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./studio-host": {
            "types": "./dist/studio-host/index.d.ts",
            "import": "./dist/studio-host/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@cirrus/codegen": "workspace:*",
        "@cirrus/container": "workspace:*",
        "@cirrus/seed": "workspace:*",
        "es-module-lexer": "catalog:vite",
        "jsonc-parser": "catalog:vite",
        "ts-morph": "catalog:tooling"
    },
    "devDependencies": {
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@cirrus/studio": "workspace:*"
    },
    "peerDependenciesMeta": {
        "@cirrus/studio": {
            "optional": true
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
