{
    "name": "@cirrus/vectors",
    "version": "0.0.0",
    "description": "Cloudflare Vectorize adapter for Cirrus: typed vector indexes and similarity search",
    "license": "FSL-1.1-Apache-2.0",
    "homepage": "https://cirrus.dev",
    "bugs": {
        "url": "https://github.com/anolilab/cirrus/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/cirrus.git",
        "directory": "packages/vectors"
    },
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "keywords": [
        "cirrus",
        "cloudflare",
        "workers",
        "durable-objects",
        "vectorize",
        "vector-search",
        "embeddings",
        "similarity-search"
    ],
    "files": [
        "dist",
        "__assets__",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "pnpm exec eslint .",
        "lint:eslint:fix": "pnpm exec eslint . --fix",
        "lint:prettier": "pnpm exec prettier --check .",
        "lint:prettier:fix": "pnpm exec prettier --write .",
        "lint:types": "pnpm exec tsc --noEmit",
        "test": "pnpm exec vitest run",
        "test:coverage": "pnpm exec vitest run --coverage"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "catalog:cloudflare",
        "@cloudflare/workers-types": "catalog:cloudflare",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test",
        "wrangler": "catalog:cloudflare"
    },
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    }
}
