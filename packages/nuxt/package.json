{
    "name": "@lunora/nuxt",
    "version": "1.0.0-alpha.32",
    "description": "Nuxt module for Lunora — single-worker composition (mounts /_lunora/* into Nitro) plus reactive-loader server helpers",
    "keywords": [
        "cloudflare",
        "durable-objects",
        "lunora",
        "nitro",
        "nuxt",
        "nuxt-module",
        "realtime",
        "ssr",
        "workers"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/nuxt"
    },
    "files": [
        "./dist",
        "README.md",
        "LICENSE.md",
        "__assets__"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/module.mjs",
    "module": "./dist/module.mjs",
    "types": "./dist/types.d.mts",
    "exports": {
        ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
        },
        "./server": {
            "types": "./dist/server.d.mts",
            "import": "./dist/server.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "nuxt-module-build build",
        "build:prod": "nuxt-module-build build",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@lunora/client": "1.0.0-alpha.23",
        "@lunora/runtime": "1.0.0-alpha.28",
        "@nuxt/kit": "^4.4.8"
    },
    "devDependencies": {
        "@nuxt/module-builder": "^1.0.2",
        "@types/node": "catalog:types",
        "@vitest/coverage-v8": "catalog:test",
        "fallow": "catalog:lint",
        "h3": "^1.15.11",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "h3": "^1.15.0",
        "nuxt": "^4.0.0"
    },
    "peerDependenciesMeta": {
        "h3": {
            "optional": true
        },
        "nuxt": {
            "optional": true
        }
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
