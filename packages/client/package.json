{
    "name": "@lunora/client",
    "version": "1.0.0-alpha.74",
    "description": "Lunora browser SDK: WebSocket transport, optimistic updates, and an offline mutation queue",
    "keywords": [
        "cloudflare",
        "durable-objects",
        "lunora",
        "offline-queue",
        "optimistic-updates",
        "realtime",
        "websocket",
        "workers"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/client"
    },
    "files": [
        "./dist",
        "README.md",
        "LICENSE.md",
        "__assets__"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./query": {
            "types": "./dist/query/index.d.ts",
            "import": "./dist/query/index.mjs"
        },
        "./auth": {
            "types": "./dist/auth/index.d.ts",
            "import": "./dist/auth/index.mjs"
        },
        "./pagination": {
            "types": "./dist/pagination/index.d.ts",
            "import": "./dist/pagination/index.mjs"
        },
        "./ssr": {
            "types": "./dist/ssr/index.d.ts",
            "import": "./dist/ssr/index.mjs"
        },
        "./upload": {
            "types": "./dist/upload.d.ts",
            "import": "./dist/upload.mjs"
        },
        "./service": {
            "types": "./dist/service.d.ts",
            "import": "./dist/service.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "test:bench": "vitest bench --run --config vitest.bench.config.ts",
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint . --max-warnings=0",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@lunora/errors": "1.0.0-alpha.30",
        "@visulima/storage-client": "catalog:storage"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "catalog:cloudflare",
        "@cloudflare/workers-types": "catalog:cloudflare",
        "@codspeed/vitest-plugin": "catalog:test",
        "@lunora/do": "1.0.0-alpha.116",
        "@lunora/runtime": "1.0.0-alpha.90",
        "@lunora/shard-engine": "1.0.0-alpha.54",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "fake-indexeddb": "catalog:test",
        "fallow": "catalog:lint",
        "ts-morph": "catalog:tooling",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test",
        "wrangler": "catalog:cloudflare"
    },
    "peerDependencies": {
        "@lunora/runtime": ">=1.0.0-alpha.76 <2.0.0-0"
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
