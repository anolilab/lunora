{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "moduleResolution": "bundler",
        "types": ["node"]
        // Intentionally no `outDir`/`rootDir`: `lint:types` is `tsc --noEmit` and the real build is
        // packem, so neither is load-bearing here. A set `rootDir` would raise TS6059 for the inlined
        // `../../../shared/field-operators` import (a file outside this package, bundled in at build time).
    },
    "include": ["src/**/*", "__tests__/**/*", "__bench__/**/*"]
}
