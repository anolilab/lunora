{
    "name": "@lunora/db",
    "version": "1.0.0-alpha.84",
    "description": "TanStack DB binding: typed, live-synced collections and a durable offline outbox over the Lunora client",
    "keywords": [
        "cloudflare",
        "durable-objects",
        "live-query",
        "lunora",
        "offline-first",
        "optimistic-updates",
        "tanstack-db",
        "workers"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "packages/db"
    },
    "files": [
        "./dist",
        "__assets__",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./collections": {
            "types": "./dist/collections/index.d.ts",
            "import": "./dist/collections/index.mjs"
        },
        "./mutators": {
            "types": "./dist/mutators/index.d.ts",
            "import": "./dist/mutators/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint . --max-warnings=0",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:bench": "vitest bench --run --config vitest.bench.config.ts",
        "test:coverage": "vitest run --coverage",
        "fallow:audit": "fallow audit",
        "fallow:dead-code": "fallow dead-code",
        "fallow:health": "fallow health --score"
    },
    "dependencies": {
        "@lunora/client": "1.0.0-alpha.81",
        "@lunora/errors": "1.0.0-alpha.32"
    },
    "devDependencies": {
        "@codspeed/vitest-plugin": "catalog:test",
        "@tanstack/db": "catalog:frontend",
        "@tanstack/offline-transactions": "catalog:frontend",
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "fallow": "catalog:lint",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@tanstack/db": "^0.6.0",
        "@tanstack/offline-transactions": "^1.0.0"
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
