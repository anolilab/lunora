{
    "name": "@cirrus/mail",
    "version": "0.0.0",
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "engines": {
        "node": "^22.15.0 || >=24.10.0"
    },
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build",
        "build:prod": "pnpm exec packem build",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:types": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@react-email/render": "catalog:mail",
        "@visulima/email": "catalog:mail"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "catalog:cloudflare",
        "@types/node": "catalog:types",
        "@types/react": "catalog:frontend",
        "@visulima/packem": "catalog:build",
        "esbuild": "catalog:build",
        "react": "catalog:frontend",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "react": "^19.2.7"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    }
}
