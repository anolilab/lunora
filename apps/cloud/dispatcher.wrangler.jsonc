{
    "$schema": "node_modules/wrangler/config-schema.json",
    // The dispatcher Worker — a SEPARATE deployable from the
    // control plane (wrangler.jsonc). Deploy with:
    //   wrangler deploy -c dispatcher.wrangler.jsonc
    "name": "lunora-dispatcher",
    "main": "src/dispatcher/worker.ts",
    "compatibility_date": "2026-06-10",
    "compatibility_flags": ["nodejs_compat"],
    // Bind the production dispatch namespace holding tenant Worker scripts.
    // (Requires the Workers-for-Platforms paid add-on.)
    // `outbound` routes every tenant `fetch()` through the Outbound Worker
    // (outbound.wrangler.jsonc, plan 365 W5), which stamps the signed lineage the
    // recursion protection verifies; `lineage` is the per-invocation parameter the
    // dispatcher passes. It also disables `connect()` for tenant Workers.
    "dispatch_namespaces": [
        {
            "binding": "DISPATCHER",
            "namespace": "lunora-production",
            "outbound": { "service": "lunora-outbound", "parameters": ["lineage"] },
        },
    ],
    // Per-request metering source (§4): the dispatcher writes one data point per
    // tenant request; the control-plane rollup reads it back via the AE SQL API.
    //
    // `PLATFORM_METRICS` is the platform's own latency/outcome stream (GAPS.md
    // E1) — the same dataset the control plane binds, never the billing meter.
    "analytics_engine_datasets": [
        { "binding": "USAGE_ANALYTICS", "dataset": "lunora_tenant_usage" },
        { "binding": "PLATFORM_METRICS", "dataset": "lunora_platform_metrics" },
    ],
    "vars": {
        "LUNORA_APP_DOMAIN": "lunora.app",
        // Control-plane base URL — enables per-plan runtime limits (GET /v1/tenants/plan).
        // Set CONTROL_PLANE_TOKEN as a secret: `wrangler secret put CONTROL_PLANE_TOKEN -c dispatcher.wrangler.jsonc`.
        // LUNORA_LINEAGE_SECRET (recursion protection) is a secret too, the same value
        // as on the Outbound Worker; unset → lineage is ignored and nothing is refused.
        "CONTROL_PLANE_URL": "https://lunora-cloud.example.workers.dev",
    },
    // Route all hostnames through the dispatcher (subdomains + custom hostnames).
    "routes": [{ "pattern": "*/*", "zone_name": "lunora.app" }],
    // Deployed environments — see the long note in `wrangler.jsonc`: a named
    // environment inherits none of the bindings above, so each restates them.
    // `.github/workflows/deploy-cloud.yml` always deploys with `--env`.
    "env": {
        "staging": {
            // No `routes`: hostname routing is this worker's whole job, and it
            // needs a staging zone to do it. Until one is attached, staging is
            // reachable on workers.dev and routes no tenant hostnames.
            "workers_dev": true,
            "dispatch_namespaces": [
                {
                    "binding": "DISPATCHER",
                    "namespace": "lunora-staging",
                    "outbound": { "service": "lunora-outbound-staging", "parameters": ["lineage"] },
                },
            ],
            "analytics_engine_datasets": [
                { "binding": "USAGE_ANALYTICS", "dataset": "lunora_tenant_usage_staging" },
                { "binding": "PLATFORM_METRICS", "dataset": "lunora_platform_metrics_staging" },
            ],
            "vars": {
                "CONTROL_PLANE_URL": "<replace-with-staging-control-plane-url>",
                "LUNORA_APP_DOMAIN": "staging.lunora.app",
            },
        },
        "production": {
            "routes": [{ "pattern": "*/*", "zone_name": "lunora.app" }],
            "dispatch_namespaces": [
                {
                    "binding": "DISPATCHER",
                    "namespace": "lunora-production",
                    "outbound": { "service": "lunora-outbound-production", "parameters": ["lineage"] },
                },
            ],
            "analytics_engine_datasets": [
                { "binding": "USAGE_ANALYTICS", "dataset": "lunora_tenant_usage" },
                { "binding": "PLATFORM_METRICS", "dataset": "lunora_platform_metrics" },
            ],
            "vars": {
                "CONTROL_PLANE_URL": "<replace-with-production-control-plane-url>",
                "LUNORA_APP_DOMAIN": "lunora.app",
            },
        },
    },
}
