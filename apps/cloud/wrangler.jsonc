{
    "$schema": "node_modules/wrangler/config-schema.json",
    // The Cirrus Cloud CONTROL-PLANE worker (the platform itself), not a tenant
    // worker. See CLOUD-PLAN.md.
    "name": "cirrus-cloud",
    "main": "src/server.ts",
    "compatibility_date": "2026-06-10",
    "compatibility_flags": ["nodejs_compat"],
    "durable_objects": {
        "bindings": [{ "name": "SHARD", "class_name": "ShardDO" }],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShardDO"] }],
    "d1_databases": [
        {
            // Control-plane DB: cells + organizations (the `.global()` tables).
            "binding": "DB",
            "database_name": "cirrus-cloud",
            "database_id": "<replace-with-d1-create-id>",
        },
    ],
    // Kept in sync with cirrus/_generated/crons.ts (CIRRUS_CRON_TRIGGERS) — the
    // hourly preview-cleanup job. Account-level worker, so triggers fire (§2.4).
    "triggers": { "crons": ["0 */1 * * *"] },
    "vars": {
        // The Cloudflare account this cell provisions into.
        "CLOUDFLARE_ACCOUNT_ID": "<replace-with-cf-account-id>",
        // Cell id + the apex the dispatcher routes tenant scripts under.
        "CIRRUS_CELL": "default",
        "CIRRUS_APP_DOMAIN": "cirrus.app",
    },
}
