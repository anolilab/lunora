{
    "$schema": "node_modules/wrangler/config-schema.json",
    // The Lunora Cloud CONTROL-PLANE worker (the platform itself), not a tenant
    // worker. See CLOUD-PLAN.md.
    "name": "lunora-cloud",
    "main": "src/server.ts",
    "compatibility_date": "2026-06-10",
    "compatibility_flags": ["nodejs_compat"],
    "durable_objects": {
        "bindings": [{ "name": "SHARD", "class_name": "ShardDO" }],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShardDO"] }],
    "d1_databases": [
        {
            // Control-plane DB: cells + organizations (the `.global()` tables).
            "binding": "DB",
            "database_name": "lunora-cloud",
            "database_id": "<replace-with-d1-create-id>",
        },
    ],
    // Bind the dispatch namespace so the every-minute tick can fan tenant cron
    // jobs out to namespaced workers (WfP drops their own triggers.crons; §2.4).
    "dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "lunora-production" }],
    // Platform-owned queue consumer (§2.4): tenants can't be queue consumers under
    // WfP, so the control plane drains a shared queue and forwards each message to
    // its tenant's /_lunora/queue. Tenant producers tag messages with their script.
    "queues": {
        "consumers": [{ "queue": "lunora-tenant-queue", "max_batch_size": 100, "max_batch_timeout": 5 }],
    },
    "triggers": {
        // `0 */1 * * *` fires the control plane's own code crons (preview cleanup,
        // usage rollup). `* * * * *` drives the tenant cron fan-out — the fan-out
        // matches each tenant's expression against the current minute (src/fanout).
        "crons": ["0 */1 * * *", "0 */6 * * *", "*/1 * * * *"],
    },
    "vars": {
        // The Cloudflare account this cell provisions into.
        "CLOUDFLARE_ACCOUNT_ID": "<replace-with-cf-account-id>",
        // Cell id + the apex the dispatcher routes tenant scripts under.
        "LUNORA_CELL": "default",
        "LUNORA_APP_DOMAIN": "lunora.app",
    },
    "analytics_engine_datasets": [
        {
            "binding": "ANALYTICS",
            "dataset": "ANALYTICS",
        },
        {
            // Observability metrics stream (issue/incident counts per ingest);
            // read back via the AE SQL API for the hosted dashboards.
            "binding": "TELEMETRY",
            "dataset": "TELEMETRY",
        },
    ],
    // Durable archive for raw decoded telemetry events (Pipeline → R2, read back
    // with R2 SQL). The bucket is bound here; the `TELEMETRY_PIPELINE` producer is
    // provisioned per cell with `wrangler pipelines create` (its remote name can't
    // be minted from config) and the telemetry store no-ops until it is present.
    "r2_buckets": [
        {
            "binding": "TELEMETRY_BUCKET",
            "bucket_name": "lunora-cloud-telemetry",
        },
    ],
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
    },
}
