# Local dev secrets for the playground worker. Copy to `.dev.vars` (gitignored)
# and fill in real values — the @cloudflare/vite-plugin loads `.dev.vars`
# automatically when you run `pnpm --filter @cirrus/playground dev`.
#
#   cp .dev.vars.example .dev.vars
#
# Generate a strong secret with: openssl rand -hex 32

# Required — the worker throws "AUTH_SECRET is required" without it.
AUTH_SECRET="replace-with-openssl-rand-hex-32"

# Base URL better-auth resolves callback URLs against. Point at the Vite dev
# origin serving the worker (default below). Adjust if you hit a different port.
AUTH_URL="http://localhost:5173"

# Signing secret for R2 signed URLs (@cirrus/storage). Any strong random value.
STORAGE_SECRET="replace-with-openssl-rand-hex-32"

# Admin token gating the studio's /_cirrus/admin/* endpoints. The @cirrus/vite
# dev route reads this same value and auto-injects it into the studio served
# at /__cirrus, so you never paste it by hand in dev. Without it, admin endpoints
# return 403 and the studio panels stay empty.
CIRRUS_ADMIN_TOKEN="replace-with-openssl-rand-hex-32"
