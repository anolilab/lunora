{
    "name": "@cirrus/playground",
    "version": "0.0.0",
    "private": true,
    "license": "FSL-1.1-Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "build": "vite build",
        "codegen": "node node_modules/@cirrus/cli/dist/bin.mjs codegen",
        "deploy": "wrangler deploy",
        "dev": "vite",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:types": "node node_modules/@cirrus/cli/dist/bin.mjs codegen && tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@cirrus/auth": "workspace:*",
        "@cirrus/client": "workspace:*",
        "@cirrus/d1": "workspace:*",
        "@cirrus/db": "workspace:*",
        "@cirrus/do": "workspace:*",
        "@cirrus/react": "workspace:*",
        "@cirrus/runtime": "workspace:*",
        "@cirrus/scheduler": "workspace:*",
        "@cirrus/server": "workspace:*",
        "@cirrus/storage": "workspace:*",
        "@cirrus/studio": "workspace:*",
        "@cirrus/vite": "workspace:*",
        "@tanstack/db": "0.6.8",
        "@tanstack/offline-transactions": "1.0.33",
        "@tanstack/react-db": "0.1.86",
        "better-auth": "catalog:auth",
        "react": "catalog:frontend",
        "react-dom": "catalog:frontend"
    },
    "devDependencies": {
        "@cirrus/cli": "workspace:*",
        "@cirrus/codegen": "workspace:*",
        "@cirrus/config": "workspace:*",
        "@cloudflare/workers-types": "catalog:cloudflare",
        "@types/node": "catalog:types",
        "@types/react": "catalog:frontend",
        "@types/react-dom": "catalog:frontend",
        "typescript": "catalog:tsc",
        "vite": "catalog:vite",
        "vitest": "catalog:test",
        "wrangler": "catalog:cloudflare"
    }
}
