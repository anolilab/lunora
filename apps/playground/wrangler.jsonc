{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "lunora-playground",
    "main": "src/server/index.ts",
    "compatibility_date": "2026-04-07",
    "compatibility_flags": ["nodejs_compat"],
    "durable_objects": {
        "bindings": [
            { "name": "SHARD", "class_name": "ShardDO" },
            { "name": "SCHEDULER", "class_name": "SchedulerDO" },
            { "name": "SHARD_REGISTRY", "class_name": "ShardRegistryDO" },
        ],
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ShardDO", "SchedulerDO"] },
        { "tag": "v2", "new_sqlite_classes": ["ShardRegistryDO"] },
    ],
    "observability": { "enabled": true, "head_sampling_rate": 1 },
    // Cloudflare Workflows are NOT Durable Objects — they are declared in
    // `exports` (keyed by class, no migration entry) and reached through
    // `ctx.exports`. The class must be exported by the worker entry (see
    // `ChannelWelcomeWorkflow` in src/server/index.ts). `lunora dev`
    // auto-reconciles this from `lunora/workflows.ts`.
    "exports": {
        "ChannelWelcomeWorkflow": { "type": "workflow", "name": "channel-welcome" },
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "lunora-playground",
            "database_id": "<replace-with-d1-create-id>",
        },
    ],
    "r2_buckets": [
        {
            "binding": "FILES",
            "bucket_name": "lunora-playground-files",
        },
        // Second bucket demonstrating multi-bucket ctx.storage + the studio file
        // browser's bucket picker (ctx.storage.bucket("avatars")).
        {
            "binding": "AVATARS",
            "bucket_name": "lunora-playground-avatars",
        },
    ],
    // Workers KV backing `ctx.kv` (see lunora/kv.ts) and the Studio's KV browser.
    // In local dev the @cloudflare/vite-plugin provisions this namespace in
    // Miniflare automatically — no Cloudflare account needed. Replace the `id`
    // with a real one (`wrangler kv namespace create KV`) before deploying.
    "kv_namespaces": [
        {
            "binding": "KV",
            "id": "<replace-with-kv-create-id>",
        },
    ],
    "vars": {
        // SET to the deployed worker's public URL before deploying. `vars` is
        // deployed config, so it ships empty rather than as a localhost or
        // placeholder value that would silently point production elsewhere;
        // unset, scheduling is refused with `ORIGIN_NOT_CONFIGURED`. In dev,
        // `.dev.vars` (see `.dev.vars.example`) supplies the local origin. The
        // SchedulerDO dispatches from this binding (read off its own env, so a
        // schedule request cannot steer it), and `.global({ origin })` fans
        // reverse cross-shard relations across it.
        //
        // There is no storage base URL here: signed object URLs follow the
        // origin the request reached the worker on.
        "LUNORA_ORIGIN_URL": "",
    },
    "queues": {
        "consumers": [
            {
                "queue": "notifications",
                "max_retries": 3,
                "dead_letter_queue": "notifications-dlq",
            },
            {
                "queue": "notifications-dlq",
            },
        ],
        "producers": [
            {
                "binding": "QUEUE_NOTIFICATIONS",
                "queue": "notifications",
            },
            {
                "binding": "QUEUE_NOTIFICATIONS_DLQ",
                "queue": "notifications-dlq",
            },
        ],
    },
}
