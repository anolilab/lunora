{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "lunora-docs",
    "main": "@tanstack/react-start/server-entry",
    "compatibility_date": "2026-10-01",
    "compatibility_flags": ["nodejs_compat"],
    "observability": { "enabled": true, "head_sampling_rate": 1, "redact_query_string": true },
    // Waitlist sign-ups from /api/waitlist, keyed `waitlist:<email>`. Replace the
    // `id` with a real one (`wrangler kv namespace create WAITLIST`) before deploying.
    // The account is not set here: deploys read CLOUDFLARE_ACCOUNT_ID from the environment.
    "kv_namespaces": [
        {
            "binding": "WAITLIST",
            "id": "<replace-with-kv-create-id>",
        },
    ],
}
