# The PostHog application URL (https://us.posthog.com or https://eu.posthog.com),
# passed to the SDK as `ui_host`. It is NOT the ingestion host — events go through
# the first-party `/pr/posthog` proxy — it only drives the "view in PostHog" links
# the toolbar renders.
VITE_PUBLIC_POSTHOG_HOST=<ph_ui_host>
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=<ph_project_token>
