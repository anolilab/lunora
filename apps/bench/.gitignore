# Vite
.vite/
dist/

# Lunora codegen output (regenerated on each build)
lunora/_generated/

# Wrangler state
.wrangler/
.dev.vars
.dev.vars.*
# …but keep the committed template that documents the required secrets.
!.dev.vars.example

# Node
node_modules/
*.tsbuildinfo

# Local env
.env*
!.env.example

# Lunora CLI state (dev server pid/log, api-spec marker)
.lunora/

# Bench output: frozen bundles, metafiles, CPU profiles, results JSON
.bench/

# Domains written by scripts/generate.mjs; the committed stub is the core-only state
lunora/domains/*
!lunora/domains/schema.ts
