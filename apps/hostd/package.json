{
    "name": "@lunora/hostd",
    "version": "0.0.0",
    "private": true,
    "description": "lunora-hostd: the daemon a customer installs on their own VPS so Lunora Cloud can run celld fleets on it, plus the versioned hostd <-> control-plane wire protocol",
    "keywords": [
        "celld",
        "control-plane",
        "daemon",
        "hostd",
        "lunora",
        "vps"
    ],
    "homepage": "https://lunora.sh",
    "bugs": "https://github.com/anolilab/lunora/issues",
    "license": "FSL-1.1-Apache-2.0",
    "author": {
        "name": "Daniel Bannert",
        "email": "d.bannert@anolilab.de"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anolilab/lunora.git",
        "directory": "apps/hostd"
    },
    "bin": {
        "lunora-hostd": "./dist/bin.mjs"
    },
    "files": [
        "./dist",
        "README.md",
        "LICENSE.md"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./protocol": {
            "types": "./dist/protocol.d.ts",
            "import": "./dist/protocol.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm exec packem build --development",
        "build:prod": "pnpm exec packem build --production",
        "lint:eslint": "eslint . --max-warnings=0",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check . --ignore-path ../../.prettierignore",
        "lint:prettier:fix": "prettier --write . --ignore-path ../../.prettierignore",
        "lint:types": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@types/node": "catalog:types",
        "@visulima/packem": "catalog:build",
        "@vitest/coverage-v8": "catalog:test",
        "esbuild": "catalog:build",
        "typescript": "catalog:tsc",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
