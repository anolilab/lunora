{
    // Standalone Cirrus worker — owns `/_cirrus/*` (RPC + WebSocket) and the
    // ShardDO class. Built and deployed independently of the Nuxt SSR worker.
    //
    // Deploy with:  wrangler deploy --config wrangler.cirrus.jsonc
    // Develop with: wrangler dev   --config wrangler.cirrus.jsonc
    //               (then set NUXT_PUBLIC_CIRRUS_URL=http://localhost:<port> in .dev.vars)
    //
    // After deploying, set NUXT_PUBLIC_CIRRUS_URL to this worker's URL
    // (e.g. https://{{name}}-cirrus.workers.dev) so the Nuxt SSR loader and
    // the browser CirrusClient know where to reach `/_cirrus/*`.
    "name": "{{name}}-cirrus",
    "main": "cirrus/server.ts",
    "compatibility_date": "2026-06-10",
    "compatibility_flags": ["nodejs_compat"],
    "durable_objects": {
        "bindings": [{ "name": "SHARD", "class_name": "ShardDO" }],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShardDO"] }],
}
