{
    "$schema": "node_modules/wrangler/config-schema.json",
    // SINGLE worker for Next.js Pages Router (vinext) + Lunora realtime.
    //
    // `main` points at `virtual:lunora/worker` — a virtual entry resolved by
    // Lunora's `frameworkComposePlugin` (in the `lunora()` Vite plugin). It emits
    // a composed worker that routes the reserved `/_lunora/{rpc,ws,admin}` paths
    // into Lunora (forwarded to the `SHARD` Durable Object) and delegates
    // everything else — pages, API routes, middleware — to vinext's router-selected
    // handler (`vinext/server/fetch-handler`, which resolves to the Pages Router
    // pipeline here). `vinext build` runs the Vite build (resolving both virtuals),
    // so the one deployed Worker carries both planes.
    "name": "{{name}}",
    "main": "virtual:lunora/worker",
    "compatibility_date": "2026-06-10",
    "compatibility_flags": ["nodejs_compat"],
    // vinext serves the client bundle through the ASSETS binding.
    "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "not_found_handling": "none",
    },
    "durable_objects": {
        "bindings": [{ "name": "SHARD", "class_name": "ShardDO" }],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShardDO"] }],
    // Blast-radius cap. Alerting is lagging by definition — by the time a
    // threshold trips, the runaway handler has already run — so a CPU ceiling is
    // one of the few controls that bounds the damage rather than reporting it.
    // Raise it if a legitimate handler needs longer.
    "limits": { "cpu_ms": 30000 },
    "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": true } },
    // Deploy attribution: the runtime reads this binding and stamps
    // `deploymentId` / `versionTag` onto every request-log row and Workers-Logs
    // event, so a spike resolves to a deploy by group-by, not by eyeballing graphs.
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
}
