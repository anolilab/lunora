{
    // SINGLE worker for SvelteKit + Cirrus realtime (PLAN4 §3, class-B).
    //
    // `main` points at `src/worker.ts` — NOT at SvelteKit's emitted
    // `_worker.js`. `src/worker.ts` imports that emitted handler, wraps it with
    // `withCirrus` (mounting Cirrus realtime under `/_cirrus/*`), and re-exports
    // the `ShardDO` class so one Worker bundles both planes.
    "name": "{{name}}",
    "main": "src/worker.ts",
    "compatibility_date": "2026-04-07",
    "compatibility_flags": ["nodejs_compat"],
    // SvelteKit's adapter writes the SSR assets/output it serves under
    // `.svelte-kit/cloudflare`; Cirrus realtime is dispatched in `src/worker.ts`
    // before SvelteKit ever sees the request.
    "assets": {
        "directory": ".svelte-kit/cloudflare",
    },
    "durable_objects": {
        "bindings": [{ "name": "SHARD", "class_name": "ShardDO" }],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShardDO"] }],
}
