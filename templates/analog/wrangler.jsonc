{
    // Single Cloudflare Worker for the whole app — Analog SSR (via Nitro's
    // `cloudflare-module` preset) AND the Lunora realtime plane (`/_lunora/*`
    // + ShardDO) in one deploy.
    //
    // `main` points at Nitro's emitted worker entry (produced by `vite build`).
    // The `ShardDO` Durable Object class is re-exported onto that entry by the
    // project-root `exports.cloudflare.ts`, so the `SHARD` binding below resolves.
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "{{name}}",
    "main": "dist/analog/server/index.mjs",
    "compatibility_date": "2026-06-10",
    "compatibility_flags": ["nodejs_compat"],
    "durable_objects": {
        "bindings": [{ "name": "SHARD", "class_name": "ShardDO" }],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShardDO"] }],
    "observability": { "enabled": true, "head_sampling_rate": 1 },
}
