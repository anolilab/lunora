{
    // Single Cloudflare Worker for the whole app — Analog SSR (via Nitro's
    // `cloudflare-module` preset) AND the Lunora realtime plane (`/_lunora/*`
    // + ShardDO) in one deploy.
    //
    // `main` points at the root `worker.ts` wrapper, NOT at Nitro's emitted
    // `dist/analog/server/index.mjs`: that output exports only the SSR handler as
    // `default`, so deploying it directly fails with "Durable Objects … not
    // exported". The wrapper re-exports it plus the `ShardDO` class, so the
    // `SHARD` binding below resolves. `dist/` exists at deploy time because the
    // `deploy` script runs `vite build` first.
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "{{name}}",
    "main": "worker.ts",
    "compatibility_date": "2026-06-10",
    "compatibility_flags": ["nodejs_compat"],
    // Nitro's Cloudflare runtime serves client assets ONLY through `env.ASSETS`
    // (`if (env.ASSETS && isPublicAssetURL(url.pathname)) return env.ASSETS.fetch(request)`).
    // Without this binding the SSR HTML renders and every `/assets/*` request
    // 404s — no hydration, no Lunora client. `dist/analog/public` is the
    // `cloudflare-module` preset's `output.publicDir`, the same directory Nitro's
    // own `wrangler deploy … --assets` command points at.
    "assets": { "binding": "ASSETS", "directory": "dist/analog/public" },
    "durable_objects": {
        "bindings": [{ "name": "SHARD", "class_name": "ShardDO" }],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShardDO"] }],
    // Blast-radius cap. Alerting is lagging by definition — by the time a
    // threshold trips, the runaway handler has already run — so a CPU ceiling is
    // one of the few controls that bounds the damage rather than reporting it.
    // Raise it if a legitimate handler needs longer.
    "limits": { "cpu_ms": 30000 },
    "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": true } },
    // Deploy attribution: the runtime reads this binding and stamps
    // `deploymentId` / `versionTag` onto every request-log row and Workers-Logs
    // event, so a spike resolves to a deploy by group-by, not by eyeballing graphs.
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
}
