# Local dev secrets for the Lunora worker (copy to `.dev.vars`, gitignored).
#
#   cp .dev.vars.example .dev.vars   # or let `lunora dev` / the Vite plugin generate it
#
# Generate a strong secret with: openssl rand -hex 32

# Required. The shard registry and event-log Durable Objects answer 403 to every request without it.
# The event-log client throws when constructed without it, and the shard-registry client fails its calls.
# It signs the calls between the worker and those objects. Local development only: the value is
# minted per checkout and never committed.
LUNORA_RELAY_SECRET="replace-with-openssl-rand-hex-32"
