# Local dev secrets for the Lunora worker (copy to `.dev.vars`, gitignored).
#
#   cp .dev.vars.example .dev.vars   # or let `lunora dev` / the Vite plugin generate it
#
# Generate a strong secret with: openssl rand -hex 32

# Required — the shard registry throws on every request without it. Signs the calls
# between the worker and its registry and event-log Durable Objects. Local development
# only: the value is minted per checkout and never committed.
LUNORA_RELAY_SECRET="replace-with-openssl-rand-hex-32"
