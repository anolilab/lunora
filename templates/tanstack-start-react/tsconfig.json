{
    "compilerOptions": {
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "noEmit": true,
        "types": ["@cloudflare/workers-types"],
        "paths": {
            "~/*": ["./src/*"]
        }
    },
    "include": ["src/**/*", "cirrus/**/*", "vite.config.ts"]
}
