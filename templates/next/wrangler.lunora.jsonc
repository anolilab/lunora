{
    // Standalone Lunora worker — owns `/_lunora/*` (RPC + WebSocket) and the
    // ShardDO class. Built and deployed independently of the Next.js SSR worker.
    //
    // Deploy with:  wrangler deploy --config wrangler.lunora.jsonc
    // Develop with: wrangler dev   --config wrangler.lunora.jsonc
    //               (then set NEXT_PUBLIC_LUNORA_URL=http://localhost:<port> in .env.local)
    //
    // After deploying, set NEXT_PUBLIC_LUNORA_URL to this worker's URL
    // (e.g. https://{{name}}-lunora.workers.dev) so the RSC loader and the
    // browser LunoraClient know where to reach `/_lunora/*`.
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "{{name}}-lunora",
    "main": "lunora/server.ts",
    "compatibility_date": "2026-06-10",
    "compatibility_flags": ["nodejs_compat"],
    "durable_objects": {
        "bindings": [{ "name": "SHARD", "class_name": "ShardDO" }],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShardDO"] }],
    "observability": { "enabled": true, "head_sampling_rate": 1 },
}
