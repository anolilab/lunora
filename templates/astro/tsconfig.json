{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "moduleResolution": "bundler",
        "types": ["@cloudflare/workers-types", "astro/client"]
    },
    "include": ["src/**/*", "lunora/**/*", "astro.config.mjs", "lunora.config.ts"],
    "exclude": ["dist"]
}
