{
    "name": "@lunora/marketing-videos",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Launch and release videos for Lunora, built with Remotion + remocn",
    "license": "UNLICENSED",
    "sideEffects": [
        "*.css"
    ],
    "scripts": {
        "dev": "remotion studio",
        "render": "remotion render",
        "render:launch": "remotion render LunoraLaunch out/lunora-launch.mp4",
        "render:vertical": "remotion render LunoraLaunchVertical out/lunora-launch-vertical.mp4",
        "render:square": "remotion render LunoraLaunchSquare out/lunora-launch-square.mp4",
        "render:webm": "remotion render LunoraLaunch out/lunora-launch.webm --codec=vp9",
        "render:social": "pnpm render:vertical && pnpm render:square",
        "render:cards": "remotion still CardSchema out/cards/schema.png --frame=110 && remotion still CardFunctions out/cards/messages.png --frame=110 && remotion still CardClient out/cards/client.png --frame=110 && remotion still CardScale out/cards/scale.png --frame=110",
        "poster": "remotion still LunoraLaunch out/poster.png --frame=120",
        "upgrade": "remotion upgrade",
        "ui:add": "shadcn@latest add",
        "lint:types": "tsc --noEmit"
    },
    "dependencies": {
        "@remotion/cli": "catalog:video",
        "@remotion/google-fonts": "catalog:video",
        "@remotion/media": "catalog:video",
        "@remotion/tailwind-v4": "catalog:video",
        "culori": "catalog:video",
        "react": "catalog:frontend",
        "react-dom": "catalog:frontend",
        "remotion": "catalog:video",
        "tailwindcss": "catalog:vite"
    },
    "devDependencies": {
        "@types/react": "catalog:frontend",
        "@types/web": "0.0.350",
        "shadcn": "catalog:ui",
        "typescript": "catalog:tsc"
    }
}
