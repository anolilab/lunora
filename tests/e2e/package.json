{
    "name": "@lunora/e2e",
    "version": "0.0.0",
    "private": true,
    "description": "End-to-end Playwright + Miniflare test suite for the Lunora playground app.",
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "e2e": "playwright test",
        "e2e:debug": "playwright test --debug",
        "e2e:examples": "playwright test --config playwright.examples.config.ts",
        "e2e:headed": "playwright test --headed",
        "e2e:ui": "playwright test --ui",
        "lint:types": "tsc --noEmit"
    },
    "devDependencies": {
        "@lunora/mail": "workspace:*",
        "@playwright/test": "catalog:e2e",
        "@types/node": "catalog:types",
        "playwright": "catalog:e2e",
        "typescript": "catalog:tsc"
    },
    "engines": {
        "node": "^22.15.0 || >=24.11.0"
    }
}
