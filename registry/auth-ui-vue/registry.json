{
    "$schema": "../schema/registry-item.schema.json",
    "name": "auth-ui-vue",
    "title": "Auth UI — Vue",
    "description": "Copy-in, user-owned Vue auth screens on top of the base `auth` item and @lunora/vue: sign in/up, forgot/reset password, magic link, email OTP, two-factor (verify + setup), account & security settings, and organizations. Framework-agnostic controllers under lunora/auth-ui/core, thin Vue views under lunora/auth-ui/vue, and minimal token-aligned CSS — no Tailwind. Edit anything; upgrades are 3-way merged.",
    "docs": "Import lunora/auth-ui/styles.css once and mount the provider from lunora/auth-ui/vue, passing the authClient from lunora/auth-ui/client.ts plus your router into the nav adapter. Requires the base `auth` server item (auto-added). Enable optional flows by also running `lunora add auth-magic-link` / `auth-otp` and flipping the matching `plugins` in lunora/auth-ui/client.ts.",
    "requires": ["auth"],
    "deps": { "@lunora/vue": "workspace:*", "@lunora/auth": "workspace:*", "@lunora/errors": "workspace:*", "better-auth": "1.7.0-rc.2" },
